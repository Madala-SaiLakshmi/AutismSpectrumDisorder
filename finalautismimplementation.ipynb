ificantly better: - | significantly worse: -\n","Saudi ->Poland 4f-src AUC    | equivalent: 7/7 | significantly better: - | significantly worse: -\n","Saudi ->Poland 4f-src BalAcc | equivalent: 7/7 | significantly better: - | significantly worse: -\n","Saudi ->NZ     13f    AUC    | equivalent: 7/7 | significantly better: - | significantly worse: -\n","Saudi ->NZ     13f    BalAcc | equivalent: 1/7 | significantly better: ['MLP-PLE', 'MLP-PLR', 'FT-Transformer', 'TabPFN', 'DL Ensemble (all)', 'DL Ensemble (top3 by val AUC)'] | significantly worse: -\n","Saudi ->NZ     4f-src AUC    | equivalent: 7/7 | significantly better: - | significantly worse: -\n","Saudi ->NZ     4f-src BalAcc | equivalent: 7/7 | significantly better: - | significantly worse: -\n"]}],"source":["if RUN_B:\n","    PERF = pd.DataFrame(perf_rows)\n","    CMPX = pd.concat(cmp_rows, ignore_index=True) if cmp_rows else pd.DataFrame()\n","    PERF.round(4).to_csv(os.path.join(CFG[\"OUT_DIR\"], \"cross_table5_performance.csv\"), index=False)\n","    CMPX.round(4).to_csv(os.path.join(CFG[\"OUT_DIR\"], \"cross_table6_dl_vs_xgboost.csv\"), index=False)\n","\n","    if len(PERF):\n","        for (s_, t_, f_), sub in PERF.groupby([\"src\", \"tgt\", \"fset\"], sort=False):\n","            sub = sub.set_index(\"model\").reindex([m for m in MODEL_ORDER if m in set(sub.model)])\n","            print(f\"\\n=== train {s_} -> test {t_} | {f_} ===\")\n","            print(sub[SHOWC].round(3).to_string())\n","        BASE_NB = {(\"NZ\", \"Saudi\", \"13f\"): (1.00, 1.00), (\"Saudi\", \"NZ\", \"13f\"): (0.98, 1.00), (\"NZ\", \"Poland\", \"13f\"): (0.85, 0.94),\n","                   (\"Saudi\", \"Poland\", \"13f\"): (0.85, 0.93), (\"NZ\", \"Saudi\", \"4f-src\"): (0.91, 0.96), (\"Saudi\", \"NZ\", \"4f-src\"): (0.86, 0.95),\n","                   (\"NZ\", \"Poland\", \"4f-src\"): (0.80, 0.85), (\"Saudi\", \"Poland\", \"4f-src\"): (0.79, 0.87)}\n","        print(\"\\n=== sanity check: our XGBoost-paper-full vs the numbers in your ML notebook (BalAcc, AUC) ===\")\n","        for k, v in BASE_NB.items():\n","            r = PERF[(PERF.src == k[0]) & (PERF.tgt == k[1]) & (PERF.fset == k[2]) & (PERF.model == \"XGBoost-paper-full\")]\n","            if len(r):\n","                print(f\"  {k[0]:6s}->{k[1]:6s} {k[2]:6s}  notebook {v}   ours ({r.BalAcc.iloc[0]:.2f}, {r.AUC.iloc[0]:.2f})\")\n","    if len(CMPX):\n","        cols = [\"model\", \"mean_model\", \"mean_xgb\", \"diff\", \"ci95_low\", \"ci95_high\", \"p_holm\", \"verdict\"]\n","        for (s_, t_, f_, met), sub in CMPX.groupby([\"src\", \"tgt\", \"fset\", \"metric\"], sort=False):\n","            print(f\"\\n--- DL vs XGBoost-paper | train {s_} -> test {t_} | {f_} | {met} ---\")\n","            print(sub[cols].round(4).to_string(index=False))\n","        print(\"\\n########  SUMMARY (DL techniques vs XGBoost-paper, cross-dataset)  ########\")\n","        for (s_, t_, f_, met), sub in CMPX.groupby([\"src\", \"tgt\", \"fset\", \"metric\"], sort=False):\n","            eq = sub[sub.verdict.str.startswith(\"EQUIVALENT\")].model.tolist()\n","            bt = sub[sub.verdict == \"SIGNIFICANTLY BETTER\"].model.tolist()\n","            wo = sub[sub.verdict == \"SIGNIFICANTLY WORSE\"].model.tolist()\n","            print(f\"{s_:6s}->{t_:6s} {f_:6s} {met:6s} | equivalent: {len(eq)}/{len(sub)} | significantly better: {bt or '-'} | significantly worse: {wo or '-'}\")"]},{"cell_type":"markdown","id":"3b2037bd","metadata":{"papermill":{"duration":0.01823,"end_time":"2026-10-18T11:47:55.866185+00:00","exception":false,"start_time":"2026-10-18T11:47:55.847955+00:00","status":"completed"},"tags":[]},"source":["## Forest plots: DL minus XGBoost per train → test pair"]},{"cell_type":"code","execution_count":52,"id":"41d8cb55","metadata":{"execution":{"iopub.execute_input":"2026-10-18T11:47:55.905103Z","iopub.status.busy":"2026-10-18T11:47:55.904243Z","iopub.status.idle":"2026-10-18T11:47:55.913453Z","shell.execute_reply":"2026-10-18T11:47:55.912856Z"},"papermill":{"duration":0.030434,"end_time":"2026-10-18T11:47:55.914918+00:00","exception":false,"start_time":"2026-10-18T11:47:55.884484+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["def forest_cross(metric):\n","    pairs = [(s_, t_) for s_ in DS for t_ in DS if s_ != t_]\n","    fig, axes = plt.subplots(len(pairs), len(FSETS), figsize=(5.4 * len(FSETS), 2.3 * len(pairs) + 1), squeeze=False)\n","    for i, (s_, t_) in enumerate(pairs):\n","        for j, f_ in enumerate(FSETS):\n","            ax = axes[i][j]\n","            sub = CMPX[(CMPX.src == s_) & (CMPX.tgt == t_) & (CMPX.fset == f_) & (CMPX.metric == metric)] if len(CMPX) else CMPX\n","            if not len(sub):\n","                ax.axis(\"off\")\n","                continue\n","            sub = sub.set_index(\"model\").reindex([m for m in CROSS_DL + [ENS_ALL, ENS_TOP3] if m in set(sub.model)])\n","            y_ = np.arange(len(sub))[::-1]\n","            delta = CFG[\"DELTA\"][metric]\n","            ax.axvspan(-delta, delta, color=\"#cfe3f5\", alpha=0.6)\n","            ax.axvline(0, color=\"k\", lw=1)\n","            ax.errorbar(sub[\"diff\"], y_, xerr=[np.clip(sub[\"diff\"] - sub[\"ci95_low\"], 0, None), np.clip(sub[\"ci95_high\"] - sub[\"diff\"], 0, None)], fmt=\"o\", color=\"#1b4f8a\", capsize=3)\n","            ax.set_yticks(y_)\n","            ax.set_yticklabels(sub.index, fontsize=7)\n","            ax.set_title(f\"train {s_} -> test {t_} | {f_} | {metric}\", fontsize=8)\n","            ax.set_xlabel(\"model minus XGBoost-paper (95% bootstrap CI)\", fontsize=7)\n","    plt.tight_layout()\n","    plt.savefig(os.path.join(CFG[\"OUT_DIR\"], f\"fig_cross_forest_{metric}.png\"), dpi=200)\n","    plt.show()"]},{"cell_type":"markdown","id":"c0941f93","metadata":{"papermill":{"duration":0.018459,"end_time":"2026-10-18T11:47:55.952566+00:00","exception":false,"start_time":"2026-10-18T11:47:55.934107+00:00","status":"completed"},"tags":[]},"source":["### Draw the forest plots"]},{"cell_type":"code","execution_count":53,"id":"86fd161e","metadata":{"execution":{"iopub.execute_input":"2026-10-18T11:47:55.992859Z","iopub.status.busy":"2026-10-18T11:47:55.992506Z","iopub.status.idle":"2026-10-18T11:48:01.037015Z","shell.execute_reply":"2026-10-18T11:48:01.03634Z"},"papermill":{"duration":5.069106,"end_time":"2026-10-18T11:48:01.040386+00:00","exception":false,"start_time":"2026-10-18T11:47:55.97128+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"image/png":"\n","text/plain":["<Figure size 1080x1480 with 12 Axes>"]},"metadata":{},"output_type":"display_data"},{"data":{"image/png":"\n","text/plain":["<Figure size 1080x1480 with 12 Axes>"]},"metadata":{},"output_type":"display_data"}],"source":["if RUN_B:\n","    if len(CMPX):\n","        forest_cross(\"AUC\")\n","        forest_cross(\"BalAcc\")"]},{"cell_type":"markdown","id":"4b95166e","metadata":{"papermill":{"duration":0.022534,"end_time":"2026-10-18T11:48:01.085401+00:00","exception":false,"start_time":"2026-10-18T11:48:01.062867+00:00","status":"completed"},"tags":[]},"source":["## ML-style report for the cross-dataset results\n","Balanced accuracy / sensitivity / specificity / ROC-AUC for each train → test pair and feature set, at threshold 0.5 and 0.3, with the confusion matrix of the first refit. The ± is the bootstrap SD over the target children (it describes test-sample noise only, not variation across training sets). The layout follows the base paper's notebook: pairs between NZ and Saudi first, then the final test on Poland."]},{"cell_type":"code","execution_count":54,"id":"c60b04de","metadata":{"execution":{"iopub.execute_input":"2026-10-18T11:48:01.130919Z","iopub.status.busy":"2026-10-18T11:48:01.130351Z","iopub.status.idle":"2026-10-18T11:48:01.141446Z","shell.execute_reply":"2026-10-18T11:48:01.14078Z"},"papermill":{"duration":0.036744,"end_time":"2026-10-18T11:48:01.14295+00:00","exception":false,"start_time":"2026-10-18T11:48:01.106206+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["def _cm_at(y, p, thr):\n","    tn, fp, fn, tp = confusion_matrix(y, (np.asarray(p) >= thr).astype(int), labels=[0, 1]).ravel()\n","    return tn, fp, fn, tp\n","\n","\n","def cross_ml_style(src, tgt, fset, thr, B=200):\n","    y = DS[tgt][1]\n","    P, S = get_preds(src, tgt, fset)\n","    rng = np.random.RandomState(CFG[\"SEED\"] + 5)\n","    idx = rng.randint(0, len(y), (B, len(y)))\n","    rows, cms = [], {}\n","    for m in MODEL_ORDER:\n","        if m not in P:\n","            continue\n","        def one(ii):\n","            yy = y[ii]\n","            vals = []\n","            for p, s_ in zip(P[m], S[m]):\n","                tn, fp, fn, tp = _cm_at(yy, p[ii], thr)\n","                se, sp = tp / max(tp + fn, 1), tn / max(tn + fp, 1)\n","                vals.append([(se + sp) / 2, se, sp, roc_auc_score(yy, s_[ii])])\n","            return np.mean(vals, 0)\n","        pt = one(np.arange(len(y)))\n","        bs = np.array([one(ii) for ii in idx])\n","        sd = bs.std(0)\n","        rows.append(dict(model=m, **{k: f\"{pt[i]:.2f} ± {sd[i]:.2f}\" for i, k in enumerate([\"Balanced accuracy\", \"Sensitivity\", \"Specificity\", \"ROC-AUC\"])}))\n","        cms[m] = np.array(_cm_at(y, P[m][0], thr)).reshape(2, 2)   # [[tn, fp], [fn, tp]]\n","    return pd.DataFrame(rows), cms\n","\n","\n","CROSS_ML = []\n","\n","\n","def show_cross(src, tgt, fset):\n","    for thr in (0.5, 0.3):\n","        tab, cms = cross_ml_style(src, tgt, fset, thr)\n","        if not len(tab):\n","            print(f\"(no results for {src} -> {tgt} / {fset})\")\n","            return\n","        what = \"all 13 features\" if fset == \"13f\" else \"4-item set found on \" + src\n","        print(f\"\\n=== train {src} -> test {tgt} | {what} | threshold {thr} ===\")\n","        print(tab.to_string(index=False))\n","        for m in (\"XGBoost-paper-full\", \"XGBoost-paper\", \"DL Ensemble (all)\"):\n","            if m in cms:\n","                print(f\"Confusion matrix, {m}:  [[TN FP], [FN TP]] = {cms[m].tolist()}\")\n","        CROSS_ML.append(tab.assign(src=src, tgt=tgt, fset=fset, threshold=thr))"]},{"cell_type":"markdown","id":"36a8f444","metadata":{"papermill":{"duration":0.023579,"end_time":"2026-10-18T11:48:01.188808+00:00","exception":false,"start_time":"2026-10-18T11:48:01.165229+00:00","status":"completed"},"tags":[]},"source":["### New Zealand models: validate on Saudi\n","#### Full-feature model (13 features)"]},{"cell_type":"code","execution_count":55,"id":"cc3bb439","metadata":{"execution":{"iopub.execute_input":"2026-10-18T11:48:01.234567Z","iopub.status.busy":"2026-10-18T11:48:01.234144Z","iopub.status.idle":"2026-10-18T11:48:22.626761Z","shell.execute_reply":"2026-10-18T11:48:22.625686Z"},"papermill":{"duration":21.418427,"end_time":"2026-10-18T11:48:22.628811+00:00","exception":false,"start_time":"2026-10-18T11:48:01.210384+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["\n","=== train NZ -> test Saudi | all 13 features | threshold 0.5 ===\n","                        model Balanced accuracy Sensitivity Specificity     ROC-AUC\n","           XGBoost-paper-full       1.00 ± 0.00 1.00 ± 0.00 1.00 ± 0.00 1.00 ± 0.00\n","                XGBoost-paper       1.00 ± 0.00 1.00 ± 0.00 1.00 ± 0.00 1.00 ± 0.00\n","                          MLP       1.00 ± 0.00 1.00 ± 0.00 1.00 ± 0.00 1.00 ± 0.00\n","                      MLP-PLE       1.00 ± 0.00 1.00 ± 0.00 1.00 ± 0.00 1.00 ± 0.00\n","                      MLP-PLR       1.00 ± 0.00 1.00 ± 0.00 1.00 ± 0.00 1.00 ± 0.00\n","               FT-Transformer       1.00 ± 0.00 1.00 ± 0.00 1.00 ± 0.00 1.00 ± 0.00\n","                       TabPFN       1.00 ± 0.00 1.00 ± 0.00 1.00 ± 0.00 1.00 ± 0.00\n","            DL Ensemble (all)       1.00 ± 0.00 1.00 ± 0.00 1.00 ± 0.00 1.00 ± 0.00\n","DL Ensemble (top3 by val AUC)       1.00 ± 0.00 1.00 ± 0.00 1.00 ± 0.00 1.00 ± 0.00\n","Confusion matrix, XGBoost-paper-full:  [[