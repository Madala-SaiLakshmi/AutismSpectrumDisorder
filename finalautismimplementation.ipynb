\n","    REFS=[\"XGBoost-paper\"],\n","    SYNTHETIC=bool(os.environ.get(\"DLP_SYNTHETIC\")),\n","    OUT_DIR=os.environ.get(\"DLP_OUT\", \"/kaggle/working/dl_full\"),\n","    MODELS=os.environ.get(\"DLP_MODELS\", \",\".join(BASELINES + DL_MODELS)).split(\",\"),\n",")\n","CFG.update(PRESETS[CFG[\"PRESET\"]])\n","os.makedirs(CFG[\"OUT_DIR\"], exist_ok=True)\n","_rd = os.environ.get(\"DLP_RESUME_DIR\")   # folder with earlier checkpoints of the SAME preset: missing files are copied here, finished work is skipped\n","if _rd and os.path.isdir(_rd) and os.path.abspath(_rd) != os.path.abspath(CFG[\"OUT_DIR\"]):\n","    import shutil\n","    for _f in (\"ckpt.pkl\", \"cross_ckpt_v2.pkl\", \"xai_ckpt.pkl\"):\n","        if os.path.exists(os.path.join(_rd, _f)) and not os.path.exists(os.path.join(CFG[\"OUT_DIR\"], _f)):\n","            shutil.copy(os.path.join(_rd, _f), CFG[\"OUT_DIR\"])\n","            print(\"resumed from earlier checkpoint:\", _f)\n","DEVICE = \"cuda\" if (HAS_TORCH and torch.cuda.is_available()) else \"cpu\"\n","np.random.seed(CFG[\"SEED\"])\n","if HAS_TORCH:\n","    torch.manual_seed(CFG[\"SEED\"])"]},{"cell_type":"markdown","id":"aff4a20e","metadata":{"papermill":{"duration":0.012393,"end_time":"2026-10-18T06:27:10.578901+00:00","exception":false,"start_time":"2026-10-18T06:27:10.566508+00:00","status":"completed"},"tags":[]},"source":["## Run switches"]},{"cell_type":"code","execution_count":4,"id":"69272719","metadata":{"execution":{"iopub.execute_input":"2026-10-18T06:27:10.607444Z","iopub.status.busy":"2026-10-18T06:27:10.607107Z","iopub.status.idle":"2026-10-18T06:27:10.61243Z","shell.execute_reply":"2026-10-18T06:27:10.611566Z"},"papermill":{"duration":0.022148,"end_time":"2026-10-18T06:27:10.613918+00:00","exception":false,"start_time":"2026-10-18T06:27:10.59177+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["parts to run: ['A', 'B', 'C']\n","device: cuda | preset: full | torch/xgb/tabpfn: True True True\n"]}],"source":["RUN = set(os.environ.get(\"DLP_RUN\", \"A,B,C\").replace(\" \", \"\").upper().split(\",\"))   # A = same-dataset, B = cross-dataset, C = XAI\n","RUN_A, RUN_B, RUN_C = \"A\" in RUN, \"B\" in RUN, \"C\" in RUN\n","print(\"parts to run:\", sorted(RUN))\n","print(\"device:\", DEVICE, \"| preset:\", CFG[\"PRESET\"], \"| torch/xgb/tabpfn:\", HAS_TORCH, HAS_XGB, HAS_TABPFN)"]},{"cell_type":"markdown","id":"54caa277","metadata":{"papermill":{"duration":0.012354,"end_time":"2026-10-18T06:27:10.638752+00:00","exception":false,"start_time":"2026-10-18T06:27:10.626398+00:00","status":"completed"},"tags":[]},"source":["## Functions: data loading and cleaning\n","One loader per country; all three return the same 13 predictors (A1-A10, age in months, gender, family history of PDD) and a binary ASD label."]},{"cell_type":"code","execution_count":5,"id":"f35010a5","metadata":{"execution":{"iopub.execute_input":"2026-10-18T06:27:10.665933Z","iopub.status.busy":"2026-10-18T06:27:10.665581Z","iopub.status.idle":"2026-10-18T06:27:10.672305Z","shell.execute_reply":"2026-10-18T06:27:10.671705Z"},"papermill":{"duration":0.021218,"end_time":"2026-10-18T06:27:10.673759+00:00","exception":false,"start_time":"2026-10-18T06:27:10.652541+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["QUESTION_COLS = [f\"A{i}_Score\" for i in range(1, 11)]\n","BASE_FEATURES = QUESTION_COLS + [\"age_months\", \"gender\", \"family_pdd\"]\n","FOUR_FEATURES = [\"A2_Score\", \"A3_Score\", \"A4_Score\", \"A5_Score\"]   # Polish 4-item set used in the base paper\n","NZ_FILE = \"/kaggle/input/datasets/madalasailakshmi/newzealanddatasetnew/Toddler Autism dataset July 2018.csv\"\n","POLAND_FILE = \"/kaggle/input/datasets/madalasailakshmi/polanddataset/QCHAT_dataset2 mendeley.sav\"\n","SAUDI_FILE = \"/kaggle/input/datasets/madalasailakshmi/saudiarabiadataset/Autism Spectrum Disorder Screening Data for Toddlers in Saudi Arabia Data Set.csv\"\n","KEYS = {\"NZ\": \"Toddler Autism\", \"Poland\": \"QCHAT_dataset2\", \"Saudi\": \"Saudi Arabia\"}\n","\n","\n","def _resolve(path, name):\n","    if os.path.exists(path):\n","        return path\n","    for root, _, files in os.walk(\"/kaggle/input\"):   # fall back to a search by file name\n","        for f in files:\n","            if KEYS[name].lower() in f.lower():\n","                return os.path.join(root, f)\n","    raise FileNotFoundError(path)\n","\n","\n","def bool_to_int(series):\n","    if pd.api.types.is_bool_dtype(series):\n","        return series.astype(float)\n","    if pd.api.types.is_numeric_dtype(series):\n","        return pd.to_numeric(series, errors=\"coerce\").astype(float)\n","    mapping = {\"yes\": 1, \"no\": 0, \"true\": 1, \"false\": 0, \"male\": 1, \"female\": 0, \"m\": 1, \"f\": 0}\n","    return series.astype(str).str.strip().str.lower().map(mapping).astype(float)"]},{"cell_type":"markdown","id":"f4caf80f","metadata":{"papermill":{"duration":0.012092,"end_time":"2026-10-18T06:27:10.698201+00:00","exception":false,"start_time":"2026-10-18T06:27:10.686109+00:00","status":"completed"},"tags":[]},"source":["### New Zealand loader"]},{"cell_type":"code","execution_count":6,"id":"5c7afcec","metadata":{"execution":{"iopub.execute_input":"2026-10-18T06:27:10.724481Z","iopub.status.busy":"2026-10-18T06:27:10.723784Z","iopub.status.idle":"2026-10-18T06:27:10.729381Z","shell.execute_reply":"2026-10-18T06:27:10.728786Z"},"papermill":{"duration":0.020468,"end_time":"2026-10-18T06:27:10.730803+00:00","exception":false,"start_time":"2026-10-18T06:27:10.710335+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["def load_new_zealand(path):\n","    df = pd.read_csv(_resolve(path, \"NZ\")).drop_duplicates().copy()\n","    df = df.rename(columns={**{f\"A{i}\": f\"A{i}_Score\" for i in range(1, 11)}, \"Age_Mons\": \"age_months\",\n","                            \"Class/ASD Traits \": \"Class/ASD\", \"Family_mem_with_ASD\": \"family_pdd\", \"Sex\": \"gender\"})\n","    for c in QUESTION_COLS + [\"age_months\"]:\n","        df[c] = pd.to_numeric(df[c], errors=\"coerce\")\n","    df[\"family_pdd\"] = bool_to_int(df[\"family_pdd\"])\n","    df[\"gender\"] = bool_to_int(df[\"gender\"])\n","    df[\"Class/ASD\"] = df[\"Class/ASD\"].astype(\"string\").str.strip().str.lower().map({\"yes\": 1.0, \"no\": 0.0})\n","    return df[BASE_FEATURES + [\"Class/ASD\"]].dropna(subset=[\"Class/ASD\"]).reset_index(drop=True)"]},{"cell_type":"markdown","id":"75ceb589","metadata":{"papermill":{"duration":0.01216,"end_time":"2026-10-18T06:27:10.754851+00:00","exception":false,"start_time":"2026-10-18T06:27:10.742691+00:00","status":"completed"},"tags":[]},"source":["### Saudi loader"]},{"cell_type":"code","execution_count":7,"id":"8b35c6a2","metadata":{"execution":{"iopub.execute_input":"2026-10-18T06:27:10.782432Z","iopub.status.busy":"2026-10-18T06:27:10.782085Z","iopub.status.idle":"2026-10-18T06:27:10.787347Z","shell.execute_reply":"2026-10-18T06:27:10.786703Z"},"papermill":{"duration":0.020335,"end_time":"2026-10-18T06:27:10.788782+00:00","exception":false,"start_time":"2026-10-18T06:27:10.768447+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["def load_saudi(path):\n","    df = pd.read_csv(_resolve(path, \"Saudi\")).drop_duplicates().copy()\n","    df = df.rename(columns={**{f\"A{i}\": f\"A{i}_Score\" for i in range(1, 11)}, \"Age\": \"age_months\", \"Class\": \"Class/ASD\",\n","                            \"Family member with ASD history\": \"family_pdd\", \"Gender\": \"gender\"})\n","    for c in QUESTION_COLS + [\"age_months\"]:\n","        df[c] = pd.to_numeric(df[c], errors=\"coerce\")\n","    df[\"gender\"] = bool_to_int(df[\"gender\"])\n","    df[\"family_pdd\"] = bool_to_int(df[\"family_pdd\"])\n","    df[\"Class/ASD\"] = pd.to_numeric(df[\"Class/ASD\"], errors=\"coerce\")\n","    return df[BASE_FEATURES + [\"Class/ASD\"]].dropna(subset=[\"Class/ASD\"]).reset_index(drop=True)"]},{"cell_type":"markdown","id":"a2513403","metadata":{"papermill":{"duration":0.01356,"end_time":"2026-10-18T06:27:10.814659+00:00","exception":false,"start_time":"2026-10-18T06:27:10.801099+00:00","status":"completed"},"tags":[]},"source":["### Polish loader"]},{"cell_type":"code","execution_count":8,"id":"1c5f105c","metadata":{"execution":{"iopub.execute_input":"2026-10-18T06:27:10.84096Z","iopub.status.busy":"2026-10-18T06:27:10.84063Z","iopub.status.idle":"2026-10-18T06:27:10.847281Z","shell.execute_reply":"2026-10-18T06:27:10.846619Z"},"papermill":{"duration":0.022045,"end_time":"2026-10-18T06:27:10.848781+00:00","exception":false,"start_time":"2026-10-18T06:27:10.826736+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["def load_poland(path):\n","    import pyreadstat\n","    df, _ = pyreadstat.read_sav(_resolve(path, \"Poland\"))\n","    df = df.drop_duplicates().copy()\n","    df = df.rename(columns={\"qchat1recode\": \"A1_Score\", \"qchat2recode\": \"A2_Score\", \"qchat5recode\": \"A3_Score\",\n","                            \"qchat6recode\": \"A4_Score\", \"qchat9recode\": \"A5_Score\", \"qchat10recode\": \"A6_Score\",\n","                            \"qchat15recode\": \"A7_Score\", \"qchat17recode\": \"A8_Score\", \"qchat19recode\": \"A9_Score\",\n","                            \"qchat25recode\": \"A10_Score\", \"age\": \"age_months\", \"group\": \"Class/ASD\",\n","                            \"sibling_withASD\": \"family_pdd\", \"sex\": \"gender\"})\n","    for c in QUESTION_COLS:   # answers 2,3,4 -> 1 ; 0,1 -> 0\n","        df[c] = pd.to_numeric(df[c], errors=\"coerce\").map(lambda v: 1.0 if v in (2, 3, 4) else (0.0 if v in (0, 1) else np.nan))\n","    df[\"age_months\"] = pd.to_numeric(df[\"age_months\"], errors=\"coerce\")\n","    df[\"gender\"] = pd.to_numeric(df[\"gender\"], errors=\"coerce\").map({1: 1.0, 2: 0.0})\n","    df[\"family_pdd\"] = pd.to_numeric(df[\"family_pdd\"], errors=\"coerce\").map({1: 1.0, 0: 0.0})\n","    df[\"Class/ASD\"] = pd.to_numeric(df[\"Class/ASD\"], errors=\"coerce\").map({1: 1, 7: 0})\n","    return df[BASE_FEATURES + [\"Class/ASD\"]].dropna(subset=[\"Class/ASD\"]).reset_index(drop=True)"]},{"cell_type":"markdown","id":"37ae8140","metadata":{"papermill":{"duration":0.012811,"end_time":"2026-10-18T06:27:10.874454+00:00","exception":false,"start_time":"2026-10-18T06:27:10.861643+00:00","status":"completed"},"tags":[]},"source":["### Synthetic stand-in data (used only for code smoke tests when the real files are absent)"]},{"cell_type":"code","execution_count":9,"id":"9ffe4899","metadata":{"execution":{"iopub.execute_input":"2026-10-18T06:27:10.901444Z","iopub.status.busy":"2026-10-18T06:27:10.901119Z","iopub.status.idle":"2026-10-18T06:27:10.907676Z","shell.execute_reply":"2026-10-18T06:27:10.906954Z"},"papermill":{"duration":0.022805,"end_time":"2026-10-18T06:27:10.909278+00:00","exception":false,"start_time":"2026-10-18T06:27:10.886473+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["def make_synthetic(seed=0):\n","    \"\"\"Fake data with the same schema (for smoke tests only). NZ/Saudi labels follow the item sum; Poland is noisy + has NaNs.\"\"\"\n","    rng = np.random.RandomState(seed)\n","    out = {}\n","    for name, n, lo, hi, noisy in [(\"Poland\", 250, 18, 24, True), (\"NZ\", 420, 12, 36, False), (\"Saudi\", 300, 12, 36, False)]:\n","        z = rng.binomial(1, 0.6, n)\n","        items = rng.binomial(1, np.where(z[:, None] == 1, 0.55, 0.15), (n, 10)).astype(float)\n","        y = z if noisy else (items.sum(1) >= 3).astype(int)\n","        X = pd.DataFrame(items, columns=QUESTION_COLS)\n","        X[\"age_months\"] = rng.randint(lo, hi + 1, n).astype(float)\n","        X[\"gender\"] = rng.binomial(1, 0.5, n).astype(float)\n","        X[\"family_pdd\"] = rng.binomial(1, 0.1 + 0.1 * y).astype(float)\n","        if noisy:\n","            X.loc[rng.choice(n, 12, replace=False), \"family_pdd\"] = np.nan\n","        out[name] = (X, y.astype(int))\n","    return out"]},{"cell_type":"markdown","id":"e77222d7","metadata":{"papermill":{"duration":0.012465,"end_time":"2026-10-18T06:27:10.933848+00:00","exception":false,"start_time":"2026-10-18T06:27:10.921383+00:00","status":"completed"},"tags":[]},"source":["### Load all three datasets"]},{"cell_type":"code","execution_count":10,"id":"7c3f252f","metadata":{"execution":{"iopub.execute_input":"2026-10-18T06:27:10.960763Z","iopub.status.busy":"2026-10-18T06:27:10.960295Z","iopub.status.idle":"2026-10-18T06:27:10.965886Z","shell.execute_reply":"2026-10-18T06:27:10.965159Z"},"papermill":{"duration":0.021399,"end_time":"2026-10-18T06:27:10.967492+00:00","exception":false,"start_time":"2026-10-18T06:27:10.946093+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["def load_all():\n","    if CFG[\"SYNTHETIC\"]:\n","        DS = make_synthetic()\n","    else:\n","        DS = {}\n","        for name, d in [(\"Poland\", load_poland(POLAND_FILE)), (\"NZ\", load_new_zealand(NZ_FILE)), (\"Saudi\", load_saudi(SAUDI_FILE))]:\n","            DS[name] = (d[BASE_FEATURES].astype(float).reset_index(drop=True), d[\"Class/ASD\"].astype(int).to_numpy())\n","    for k, (X, y) in DS.items():\n","        assert list(X.columns) == BASE_FEATURES and set(np.unique(y)) == {0, 1}, k\n","        print(f\"{k:7s} n={len(y):4d}  ASD share={y.mean():.2f}  missing predictor cells={int(X.isna().sum().sum())}  \"\n","              f\"age {np.nanmin(X.age_months):.0f}-{np.nanmax(X.age_months):.0f}\")\n","    return DS"]},{"cell_type":"markdown","id":"b0388857","metadata":{"papermill":{"duration":0.013991,"end_time":"2026-10-18T06:27:10.993397+00:00","exception":false,"start_time":"2026-10-18T06:27:10.979406+00:00","status":"completed"},"tags":[]},"source":["## Functions: inner validation split, class balancing and metrics\n","Every metric is computed from the model's probabilities on the held-out fold; ECE and sensitivity at 90% specificity are secondary metrics."]},{"cell_type":"code","execution_count":11,"id":"1faa2b25","metadata":{"execution":{"iopub.execute_input":"2026-10-18T06:27:11.022787Z","iopub.status.busy":"2026-10-18T06:27:11.022295Z","iopub.status.idle":"2026-10-18T06:27:11.032797Z","shell.execute_reply":"2026-10-18T06:27:11.032265Z"},"papermill":{"duration":0.024954,"end_time":"2026-10-18T06:27:11.034281+00:00","exception":false,"start_time":"2026-10-18T06:27:11.009327+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["def inner_split(ytr, seed):\n","    a, b = train_test_split(np.arange(len(ytr)), test_size=CFG[\"INNER_VAL\"], stratify=ytr, random_state=seed)\n","    return a, b\n","\n","\n","def balance(X, y, seed):\n","    \"\"\"Optional SMOTE on the (inner) training part only; binary columns are snapped back to 0/1.\"\"\"\n","    if CFG[\"BALANCE\"] != \"smote\" or not HAS_IMB:\n","        return X, y\n","    k = min(5, int(np.bincount(y).min()) - 1)\n","    if k < 1:\n","        return X, y\n","    binary = np.array([np.isin(X[:, j], [0, 1]).all() for j in range(X.shape[1])])\n","    Xb, yb = SMOTE(random_state=seed, k_neighbors=k).fit_resample(X, y)\n","    Xb = Xb.astype(\"float32\")\n","    Xb[:, binary] = np.rint(Xb[:, binary])\n","    return Xb, yb\n","\n","\n","def ece_score(y, p, bins=10):\n","    edges = np.linspace(0, 1, bins + 1)\n","    idx = np.clip(np.digitize(p, edges[1:-1]), 0, bins - 1)\n","    return float(sum(abs(y[idx == b].mean() - p[idx == b].mean()) * (idx == b).mean() for b in range(bins) if (idx == b).any()))\n","\n","\n","def sens_at_spec(y, p, spec=0.90):\n","    fpr, tpr, _ = roc_curve(y, p)\n","    ok = fpr <= (1 - spec)\n","    return float(tpr[ok].max()) if ok.any() else 0.0\n","\n","\n","def all_metrics(y, p):\n","    y = np.asarray(y).astype(int)\n","    p = np.clip(np.asarray(p, dtype=float), 1e-6, 1 - 1e-6)\n","    out = {}\n","    for thr, sfx in [(0.5, \"\"), (0.3, \"_t03\")]:\n","        tn, fp, fn, tp = confusion_matrix(y, (p >= thr).astype(int), labels=[0, 1]).ravel()\n","        se, sp = tp / max(tp + fn, 1), tn / max(tn + fp, 1)\n","        out.update({\"Sens\" + sfx: se, \"Spec\" + sfx: sp, \"BalAcc\" + sfx: (se + sp) / 2})\n","    out.update(AUC=roc_auc_score(y, p), PRAUC=average_precision_score(y, p), Brier=brier_score_loss(y, p),\n","               ECE=ece_score(y, p), Sens_at_90Spec=sens_at_spec(y, p))\n","    return out"]},{"cell_type":"markdown","id":"34e8b762","metadata":{"papermill":{"duration":0.013118,"end_time":"2026-10-18T06:27:11.05956+00:00","exception":false,"start_time":"2026-10-18T06:27:11.046442+00:00","status":"completed"},"tags":[]},"source":["## Functions: hyper-parameters, networks and model wrappers\n","`DEFAULTS` are the trial-0 settings of every network; `XGB_PAPER` are the base paper's fixed XGBoost settings, one per dataset."]},{"cell_type":"code","execution_count":12,"id":"09f6d7c6","metadata":{"execution":{"iopub.execute_input":"2026-10-18T06:27:11.086269Z","iopub.status.busy":"2026-10-18T06:27:11.085947Z","iopub.status.idle":"2026-10-18T06:27:11.091497Z","shell.execute_reply":"2026-10-18T06:27:11.090933Z"},"papermill":{"duration":0.021062,"end_time":"2026-10-18T06:27:11.09283+00:00","exception":false,"start_time":"2026-10-18T06:27:11.071768+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["DEFAULTS = {\n","    \"MLP\": dict(hidden=64, depth=2, dropout=0.2, lr=1e-3, wd=1e-4, bs=32),\n","    \"MLP-PLE\": dict(hidden=64, depth=2, dropout=0.2, lr=1e-3, wd=1e-4, bs=32, bins=16),\n","    \"MLP-PLR\": dict(hidden=64, depth=2, dropout=0.2, lr=1e-3, wd=1e-4, bs=32, k=8, d=8, sigma=0.5),\n","    \"FT-Transformer\": dict(d=32, blocks=2, heads=4, dropout=0.1, lr=5e-4, wd=1e-4, bs=32),\n","}\n","# XGBoost settings exactly as used in the base paper's ML notebook (one fixed config per dataset; no search here).\n","XGB_PAPER = {\n","    \"Poland\": dict(n_estimators=400, max_depth=1, learning_rate=0.3, subsample=1.0, colsample_bytree=1.0, gamma=0.5, reg_lambda=2, reg_alpha=0),\n","    \"NZ\":     dict(n_estimators=300, max_depth=10, learning_rate=0.3, subsample=0.8, colsample_bytree=0.5, gamma=0.3, reg_lambda=3, reg_alpha=0.1),\n","    \"Saudi\":  dict(n_estimators=300, max_depth=7, learning_rate=0.1, subsample=0.5, colsample_bytree=0.7, gamma=0, reg_lambda=3, reg_alpha=0.1),\n","}"]},{"cell_type":"markdown","id":"6cc70bc3","metadata":{"papermill":{"duration":0.013617,"end_time":"2026-10-18T06:27:11.118427+00:00","exception":false,"start_time":"2026-10-18T06:27:11.10481+00:00","status":"completed"},"tags":[]},"source":["### Random hyper-parameter sampling"]},{"cell_type":"code","execution_count":13,"id":"e386e2a9","metadata":{"execution":{"iopub.execute_input":"2026-10-18T06:27:11.144144Z","iopub.status.busy":"2026-10-18T06:27:11.143724Z","iopub.status.idle":"2026-10-18T06:27:11.150853Z","shell.execute_reply":"2026-10-18T06:27:11.15016Z"},"papermill":{"duration":0.021669,"end_time":"2026-10-18T06:27:11.152243+00:00","exception":false,"start_time":"2026-10-18T06:27:11.130574+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["def _logu(rng, lo, hi):\n","    return float(np.exp(rng.uniform(np.log(lo), np.log(hi))))\n","\n","\n","def sample_params(name, rng):\n","    ch = lambda xs: xs[rng.randint(len(xs))]\n","    if name in (\"MLP\", \"MLP-PLE\", \"MLP-PLR\"):\n","        p = dict(hidden=ch([32, 64, 128]), depth=ch([1, 2, 3]), dropout=ch([0.0, 0.1, 0.2, 0.3, 0.4]),\n","                 lr=_logu(rng, 3e-4, 3e-3), wd=_logu(rng, 1e-5, 1e-2), bs=ch([32, 64]))\n","        if name == \"MLP-PLE\":\n","            p.update(bins=ch([8, 16]))\n","        if name == \"MLP-PLR\":\n","            p.update(k=ch([4, 8]), d=ch([4, 8]), sigma=ch([0.05, 0.1, 0.5, 1.0]))\n","        return p\n","    if name == \"FT-Transformer\":\n","        return dict(d=ch([16, 32, 64]), blocks=ch([1, 2, 3]), heads=ch([2, 4]), dropout=ch([0.0, 0.1, 0.2]),\n","                    lr=_logu(rng, 1e-4, 2e-3), wd=_logu(rng, 1e-5, 1e-3), bs=ch([32, 64]))\n","    raise KeyError(name)"]},{"cell_type":"markdown","id":"40e26469","metadata":{"papermill":{"duration":0.012351,"end_time":"2026-10-18T06:27:11.176692+00:00","exception":false,"start_time":"2026-10-18T06:27:11.164341+00:00","status":"completed"},"tags":[]},"source":["### Networks: MLP, MLP-PLE (piecewise-linear encoding), MLP-PLR (periodic), FT-Transformer"]},{"cell_type":"code","execution_count":14,"id":"04b395df","metadata":{"execution":{"iopub.execute_input":"2026-10-18T06:27:11.204692Z","iopub.status.busy":"2026-10-18T06:27:11.203955Z","iopub.status.idle":"2026-10-18T06:27:11.21113Z","shell.execute_reply":"2026-10-18T06:27:11.210392Z"},"papermill":{"duration":0.023979,"end_time":"2026-10-18T06:27:11.212739+00:00","exception":false,"start_time":"2026-10-18T06:27:11.18876+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["# ---- torch networks (all return logits) ----\n","class MLPNet(nn.Module):\n","    def __init__(self, n_in, hidden=64, depth=2, dropout=0.2):\n","        super().__init__()\n","        layers, d = [], n_in\n","        for _ in range(depth):\n","            layers += [nn.Linear(d, hidden), nn.ReLU(), nn.Dropout(dropout)]\n","            d = hidden\n","        self.net = nn.Sequential(*layers, nn.Linear(d, 1))\n","\n","    def forward(self, x):\n","        return self.net(x).squeeze(-1)\n","\n","\n","class PLENet(nn.Module):\n","    \"\"\"Piecewise-linear (triangular) encoding of every standardised feature, then an MLP.\"\"\"\n","    def __init__(self, n_in, bins=16, hidden=64, depth=2, dropout=0.2):\n","        super().__init__()\n","        self.bins = bins\n","        self.register_buffer(\"knots\", torch.arange(bins, dtype=torch.float32))\n","        self.mlp = MLPNet(n_in * bins, hidden, depth, dropout)\n","\n","    def forward(self, x):\n","        x01 = torch.clamp((x + 3.0) / 6.0, 0.0, 1.0)   # standardised inputs clipped to [-3, 3]\n","        basis = torch.relu(1.0 - torch.abs(x01.unsqueeze(-1) * (self.bins - 1) - self.knots))\n","        return self.mlp(basis.flatten(1))"]},{"cell_type":"markdown","id":"38debafa","metadata":{"papermill":{"duration":0.012353,"end_time":"2026-10-18T06:27:11.238765+00:00","exception":false,"start_time":"2026-10-18T06:27:11.226412+00:00","status":"completed"},"tags":[]},"source":["#### MLP-PLR and FT-Transformer"]},{"cell_type":"code","execution_count":15,"id":"bd14b7f1","metadata":{"execution":{"iopub.execute_input":"2026-10-18T06:27:11.268618Z","iopub.status.busy":"2026-10-18T06:27:11.268325Z","iopub.status.idle":"2026-10-18T06:27:11.279145Z","shell.execute_reply":"2026-10-18T06:27:11.278574Z"},"papermill":{"duration":0.029672,"end_time":"2026-10-18T06:27:11.280595+00:00","exception":false,"start_time":"2026-10-18T06:27:11.250923+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["class PLRNet(nn.Module):\n","    \"\"\"Periodic-linear-ReLU numerical embeddings per feature (Gorishniy et al., 2022), then an MLP.\"\"\"\n","    def __init__(self, n_in, hidden=64, depth=2, dropout=0.2, k=8, d=8, sigma=0.5):\n","        super().__init__()\n","        self.freq = nn.Parameter(torch.randn(n_in, k) * sigma)\n","        self.W = nn.Parameter(torch.randn(n_in, 2 * k, d) / math.sqrt(2 * k))\n","        self.b = nn.Parameter(torch.zeros(n_in, d))\n","        self.mlp = MLPNet(n_in * d, hidden, depth, dropout)\n","\n","    def forward(self, x):\n","        v = 2 * math.pi * x.unsqueeze(-1) * self.freq\n","        v = torch.cat([torch.sin(v), torch.cos(v)], -1)\n","        v = torch.relu(torch.einsum(\"bnk,nkd->bnd\", v, self.W) + self.b)\n","        return self.mlp(v.flatten(1))\n","\n","\n","class FTTNet(nn.Module):\n","    \"\"\"FT-Transformer: every feature becomes a token, plus a [CLS] token, pre-norm transformer encoder.\"\"\"\n","    def __init__(self, n_in, d=32, blocks=2, heads=4, dropout=0.1):\n","        super().__init__()\n","        s = 1 / math.sqrt(d)\n","        self.W = nn.Parameter(torch.empty(n_in, d).uniform_(-s, s))\n","        self.b = nn.Parameter(torch.empty(n_in, d).uniform_(-s, s))\n","        self.cls = nn.Parameter(torch.randn(1, 1, d) * 0.02)\n","        layer = nn.TransformerEncoderLayer(d_model=d, nhead=heads, dim_feedforward=2 * d, dropout=dropout,\n","                                           activation=\"gelu\", batch_first=True, norm_first=True)\n","        self.enc = nn.TransformerEncoder(layer, num_layers=blocks, enable_nested_tensor=False)\n","        self.head = nn.Sequential(nn.LayerNorm(d), nn.ReLU(), nn.Linear(d, 1))\n","\n","    def forward(self, x):\n","        t = x.unsqueeze(-1) * self.W + self.b\n","        t = torch.cat([self.cls.expand(len(x), -1, -1), t], 1)\n","        return self.head(self.enc(t)[:, 0]).squeeze(-1)\n","\n","\n","NET_BUILDERS = {\n","    \"MLP\": lambda n, p: MLPNet(n, p[\"hidden\"], p[\"depth\"], p[\"dropout\"]),\n","    \"MLP-PLE\": lambda n, p: PLENet(n, p[\"bins\"], p[\"hidden\"], p[\"depth\"], p[\"dropout\"]),\n","    \"MLP-PLR\": lambda n, p: PLRNet(n, p[\"hidden\"], p[\"depth\"], p[\"dropout\"], p[\"k\"], p[\"d\"], p[\"sigma\"]),\n","    \"FT-Transformer\": lambda n, p: FTTNet(n, p[\"d\"], p[\"blocks\"], p[\"heads\"], p[\"dropout\"]),\n","}"]},{"cell_type":"markdown","id":"d266d9e1","metadata":{"papermill":{"duration":0.013173,"end_time":"2026-10-18T06:27:11.306257+00:00","exception":false,"start_time":"2026-10-18T06:27:11.293084+00:00","status":"completed"},"tags":[]},"source":["### Training loop (early stopping on the inner validation split) and predictions"]},{"cell_type":"code","execution_count":16,"id":"98436077","metadata":{"execution":{"iopub.execute_input":"2026-10-18T06:27:11.334793Z","iopub.status.busy":"2026-10-18T06:27:11.334325Z","iopub.status.idle":"2026-10-18T06:27:11.343779Z","shell.execute_reply":"2026-10-18T06:27:11.343038Z"},"papermill":{"duration":0.02546,"end_time":"2026-10-18T06:27:11.345559+00:00","exception":false,"start_time":"2026-10-18T06:27:11.320099+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["def fit_net(net, Xtr, ytr, Xva, yva, p, seed, max_epochs, patience, pos_weight=1.0):\n","    \"\"\"AdamW + BCE with early stopping on the inner validation loss (gradient clipping at 1.0).\"\"\"\n","    torch.manual_seed(seed)\n","    net = net.to(DEVICE)\n","    opt = torch.optim.AdamW(net.parameters(), lr=p[\"lr\"], weight_decay=p[\"wd\"])\n","    Xt = torch.tensor(Xtr, dtype=torch.float32, device=DEVICE)\n","    yt = torch.tensor(ytr, dtype=torch.float32, device=DEVICE)\n","    Xv = torch.tensor(Xva, dtype=torch.float32, device=DEVICE)\n","    yv = torch.tensor(yva, dtype=torch.float32, device=DEVICE)\n","    pw = torch.tensor(float(pos_weight), device=DEVICE)\n","    n, bs = len(Xt), int(p[\"bs\"])\n","    best, bad, best_state = float(\"inf\"), 0, copy.deepcopy(net.state_dict())\n","    for ep in range(max_epochs):\n","        net.train()\n","        perm = torch.randperm(n, device=DEVICE)\n","        for i in range(0, n, bs):\n","            idx = perm[i:i + bs]\n","            if len(idx) < 2:\n","                continue\n","            opt.zero_grad()\n","            F.binary_cross_entropy_with_logits(net(Xt[idx]), yt[idx], pos_weight=pw).backward()\n","            torch.nn.utils.clip_grad_norm_(net.parameters(), 1.0)\n","            opt.step()\n","        net.eval()\n","        with torch.no_grad():\n","            vl = F.binary_cross_entropy_with_logits(net(Xv), yv).item()\n","        if vl < best - 1e-5:\n","            best, bad, best_state = vl, 0, copy.deepcopy(net.state_dict())\n","        else:\n","            bad += 1\n","            if bad >= patience:\n","                break\n","    net.load_state_dict(best_state)\n","    return net.eval()\n","\n","\n","def predict_net(net, Xs):\n","    with torch.no_grad():\n","        return torch.sigmoid(net(torch.tensor(Xs, dtype=torch.float32, device=DEVICE))).cpu().numpy()\n","\n","\n","def score_net(net, Xs):\n","    with torch.no_grad():\n","        return net(torch.tensor(Xs, dtype=torch.float32, device=DEVICE)).cpu().numpy()"]},{"cell_type":"markdown","id":"1a1a7466","metadata":{"papermill":{"duration":0.011948,"end_time":"2026-10-18T06:27:11.370701+00:00","exception":false,"start_time":"2026-10-18T06:27:11.358753+00:00","status":"completed"},"tags":[]},"source":["### Model wrappers: seed-ensembled networks, TabPFN, XGBoost with the paper's settings"]},{"cell_type":"code","execution_count":17,"id":"dfb016e7","metadata":{"execution":{"iopub.execute_input":"2026-10-18T06:27:11.397933Z","iopub.status.busy":"2026-10-18T06:27:11.397211Z","iopub.status.idle":"2026-10-18T06:27:11.40805Z","shell.execute_reply":"2026-10-18T06:27:11.40735Z"},"papermill":{"duration":0.026907,"end_time":"2026-10-18T06:27:11.409531+00:00","exception":false,"start_time":"2026-10-18T06:27:11.382624+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["class TorchModel:\n","    def __init__(self, kind, params, seed, n_seeds=1):\n","        self.kind, self.params, self.seed, self.n_seeds = kind, params, seed, n_seeds\n","\n","    def fit(self, X, y, Xva, yva):\n","        self.scaler = StandardScaler().fit(X)\n","        pw = float((y == 0).sum() / max((y == 1).sum(), 1)) if CFG[\"BALANCE\"] == \"weighted\" else 1.0\n","        self.nets = [fit_net(NET_BUILDERS[self.kind](X.shape[1], self.params), self.scaler.transform(X), y,\n","                             self.scaler.transform(Xva), yva, self.params, self.seed + s, CFG[\"MAX_EPOCHS\"], CFG[\"PATIENCE\"], pw)\n","                     for s in range(self.n_seeds)]\n","        return self\n","\n","    def predict_proba(self, X):\n","        Xs = self.scaler.transform(X)\n","        return np.mean([predict_net(n, Xs) for n in self.nets], 0)\n","\n","    def predict_score(self, X):   # mean pre-sigmoid logit over the seed ensemble (ranking is not lost to float32 saturation)\n","        Xs = self.scaler.transform(X)\n","        return np.mean([score_net(n, Xs) for n in self.nets], 0)\n","\n","\n","class TabPFNModel:\n","    def __init__(self, params, seed, n_estimators=None):\n","        self.seed, self.n_est = seed, n_estimators or CFG[\"TABPFN_ESTIMATORS\"]\n","\n","    def fit(self, X, y, Xva, yva):\n","        self.m = TabPFNClassifier(n_estimators=self.n_est, device=DEVICE, random_state=self.seed).fit(X, y)\n","        return self\n","\n","    def predict_proba(self, X):\n","        return self.m.predict_proba(X)[:, 1]\n","\n","\n","class XGBPaper:\n","    \"\"\"XGBoost with the base paper's fixed settings (no tuning, no early stopping).\"\"\"\n","    def __init__(self, ds, seed):\n","        self.ds, self.seed = ds, seed\n","\n","    def fit(self, X, y, Xva, yva):\n","        self.m = XGBClassifier(**XGB_PAPER[self.ds], eval_metric=\"logloss\", tree_method=\"hist\", random_state=self.seed,\n","                               n_jobs=2, verbosity=0).fit(X, y)\n","        return self\n","\n","    def predict_proba(self, X):\n","        return self.m.predict_proba(X)[:, 1]"]},{"cell_type":"markdown","id":"30fbd34e","metadata":{"papermill":{"duration":0.01287,"end_time":"2026-10-18T06:27:11.435708+00:00","exception":false,"start_time":"2026-10-18T06:27:11.422838+00:00","status":"completed"},"tags":[]},"source":["### Model factory and the random hyper-parameter search"]},{"cell_type":"code","execution_count":18,"id":"d9e8265d","metadata":{"execution":{"iopub.execute_input":"2026-10-18T06:27:11.461953Z","iopub.status.busy":"2026-10-18T06:27:11.461595Z","iopub.status.idle":"2026-10-18T06:27:11.469064Z","shell.execute_reply":"2026-10-18T06:27:11.46842Z"},"papermill":{"duration":0.022163,"end_time":"2026-10-18T06:27:11.470579+00:00","exception":false,"start_time":"2026-10-18T06:27:11.448416+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["def make_model(name, params, seed, ds, n_seeds=1):\n","    if name == \"XGBoost-paper\":\n","        assert HAS_XGB, \"xgboost not installed\"\n","        return XGBPaper(ds, seed)\n","    if name in NET_BUILDERS:\n","        assert HAS_TORCH, \"torch not installed\"\n","        return TorchModel(name, params, seed, n_seeds)\n","    if name in (\"TabPFN\", \"TabPFN-x32\"):\n","        assert HAS_TABPFN, \"tabpfn not installed / weights not available (turn Internet ON; pinned tabpfn<2.5)\"\n","        return TabPFNModel(params, seed, 32 if name == \"TabPFN-x32\" else None)\n","    raise KeyError(name)\n","\n","\n","def tune_params(name, ds, X, y, Xva, yva, seed):\n","    \"\"\"Random search on the inner validation split; trial 0 = defaults; score = val AUC - 0.001 * val logloss.\"\"\"\n","    rng, best = np.random.RandomState(seed), None\n","    for t in range(CFG[\"N_TRIALS\"]):\n","        p = DEFAULTS[name] if t == 0 else sample_params(name, rng)\n","        try:\n","            pv = make_model(name, p, seed, ds).fit(X, y, Xva, yva).predict_proba(Xva)\n","        except AssertionError:\n","            raise\n","        except Exception as e:\n","            print(f\"   trial failed ({name}): {str(e)[:80]}\")\n","            continue\n","        sc = roc_auc_score(yva, pv) - 1e-3 * log_loss(yva, np.clip(pv, 1e-6, 1 - 1e-6), labels=[0, 1])\n","        if best is None or sc > best[0]:\n","            best = (sc, p)\n","    return best[1] if best else DEFAULTS[name]"]},{"cell_type":"markdown","id":"af80ef3e","metadata":{"papermill":{"duration":0.012949,"end_time":"2026-10-18T06:27:11.496211+00:00","exception":false,"start_time":"2026-10-18T06:27:11.483262+00:00","status":"completed"},"tags":[]},"source":["## Functions: statistics helpers"]},{"cell_type":"code","execution_count":19,"id":"c0fc33a7","metadata":{"execution":{"iopub.execute_input":"2026-10-18T06:27:11.525504Z","iopub.status.busy":"2026-10-18T06:27:11.525135Z","iopub.status.idle":"2026-10-18T06:27:11.529656Z","shell.execute_reply":"2026-10-18T06:27:11.529045Z"},"papermill":{"duration":0.022576,"end_time":"2026-10-18T06:27:11.531198+00:00","exception":false,"start_time":"2026-10-18T06:27:11.508622+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["def holm(pvals):\n","    \"\"\"Holm step-down adjustment of a list of p-values.\"\"\"\n","    pvals = np.asarray(pvals, float)\n","    order_ = np.argsort(pvals)\n","    adj, running = np.empty(len(pvals)), 0.0\n","    for rank, i in enumerate(order_):\n","        running = max(running, (len(pvals) - rank) * pvals[i])\n","        adj[i] = min(1.0, running)\n","    return adj"]},{"cell_type":"markdown","id":"3ad10b48","metadata":{"papermill":{"duration":0.012815,"end_time":"2026-10-18T06:27:11.556346+00:00","exception":false,"start_time":"2026-10-18T06:27:11.543531+00:00","status":"completed"},"tags":[]},"source":["# Load / Clean Data\n","## New Zealand, Polish and Saudi datasets\n","Cleaning (boolean text -> 0/1, duplicates, ambiguous classes, missing values) happens inside the loaders; the printout shows sample size, ASD share, missing predictor cells and the age range. Missing values are imputed later, inside each training fold."]},{"cell_type":"code","execution_count":20,"id":"c91cc4f0","metadata":{"execution":{"iopub.execute_input":"2026-10-18T06:27:11.583595Z","iopub.status.busy":"2026-10-18T06:27:11.583238Z","iopub.status.idle":"2026-10-18T06:27:11.875416Z","shell.execute_reply":"2026-10-18T06:27:11.874486Z"},"papermill":{"duration":0.307876,"end_time":"2026-10-18T06:27:11.877418+00:00","exception":false,"start_time":"2026-10-18T06:27:11.569542+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Poland  n= 252  ASD share=0.54  missing predictor cells=22  age 18-24\n","NZ      n=1054  ASD share=0.69  missing predictor cells=0  age 12-36\n","Saudi   n= 481  ASD share=0.68  missing predictor cells=0  age 12-36\n"]}],"source":["DS = load_all()\n","# Feature sets: every dataset gets the full 13 features and an in-fold selected top-4 set (chosen inside each training fold\n","# with a random forest); Poland also gets the fixed 4-item set from the base paper.\n","FEATURE_SETS = {\"Poland\": [\"13f\", \"top4\", \"paper4\"], \"NZ\": [\"13f\", \"top4\"], \"Saudi\": [\"13f\", \"top4\"]}"]},{"cell_type":"markdown","id":"a7954b8b","metadata":{"papermill":{"duration":0.013941,"end_time":"2026-10-18T06:27:11.906108+00:00","exception":false,"start_time":"2026-10-18T06:27:11.892167+00:00","status":"completed"},"tags":[]},"source":["# Preprocessing\n","## Repeated stratified 5-fold splits shared by every model\n","The outer splits are created once; every model sees exactly the same training and test children. Imputation and class balancing are fitted on the training part only."]},{"cell_type":"code","execution_count":21,"id":"8a13db0b","metadata":{"execution":{"iopub.execute_input":"2026-10-18T06:27:11.935652Z","iopub.status.busy":"2026-10-18T06:27:11.934918Z","iopub.status.idle":"2026-10-18T06:27:11.955469Z","shell.execute_reply":"2026-10-18T06:27:11.954701Z"},"papermill":{"duration":0.037143,"end_time":"2026-10-18T06:27:11.956966+00:00","exception":false,"start_time":"2026-10-18T06:27:11.919823+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["{'Poland': 25, 'NZ': 25, 'Saudi': 25} outer folds per dataset\n"]}],"source":["SPLITS = {}\n","for _ds, (_X, _y) in DS.items():   # outer splits are created once and shared by EVERY model\n","    rskf = RepeatedStratifiedKFold(n_splits=CFG[\"N_SPLITS\"], n_repeats=CFG[\"N_REPEATS\"], random_state=CFG[\"SEED\"])\n","    SPLITS[_ds] = [dict(rep=i // CFG[\"N_SPLITS\"], fold=i % CFG[\"N_SPLITS\"], train=tr.tolist(), test=te.tolist())\n","                   for i, (tr, te) in enumerate(rskf.split(_X, _y))]\n","\n","\n","\n","print({k: len(v) for k, v in SPLITS.items()}, \"outer folds per dataset\")"]},{"cell_type":"markdown","id":"a1ba4dd1","metadata":{"papermill":{"duration":0.01195,"end_time":"2026-10-18T06:27:11.981286+00:00","exception":false,"start_time":"2026-10-18T06:27:11.969336+00:00","status":"completed"},"tags":[]},"source":["# Baseline Model Testing: same-dataset results (Part A)\n","Each country is evaluated separately with repeated stratified 5-fold CV (repeats x 5 folds). XGBoost uses the base paper's fixed settings; the DL models are tuned by random search on an inner validation split. Everything is checkpointed, so a stopped run resumes where it ended.\n","## Checkpoint and CV runner"]},{"cell_type":"code","execution_count":22,"id":"a69f7dc7","metadata":{"execution":{"iopub.execute_input":"2026-10-18T06:27:12.009317Z","iopub.status.busy":"2026-10-18T06:27:12.008669Z","iopub.status.idle":"2026-10-18T06:27:12.014445Z","shell.execute_reply":"2026-10-18T06:27:12.013848Z"},"papermill":{"duration":0.022372,"end_time":"2026-10-18T06:27:12.015891+00:00","exception":false,"start_time":"2026-10-18T06:27:11.993519+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["if RUN_A:\n","    CKPT_PATH = os.path.join(CFG[\"OUT_DIR\"], \"ckpt.pkl\")\n","    _imp = os.environ.get(\"DLP_CKPT_IMPORT\")   # optional: an earlier ckpt.pkl (same preset!) whose finished runs are reused\n","    if _imp and CFG[\"PRESET\"] == \"full\" and os.path.exists(_imp) and not os.path.exists(CKPT_PATH):\n","        import shutil\n","        shutil.copy(_imp, CKPT_PATH)\n","        print(\"imported earlier checkpoint:\", _imp)\n","    if os.path.exists(CKPT_PATH):\n","        CKPT = pickle.load(open(CKPT_PATH, \"rb\"))\n","        print(\"resumed checkpoint with\", len(CKPT[\"rows\"]), \"finished runs\")\n","    else:\n","        CKPT = dict(rows={}, preds={}, tuned={})   # keys: (dataset, featureset, model)\n","\n","\n","    def _save_ckpt():\n","        pickle.dump(CKPT, open(CKPT_PATH + \".tmp\", \"wb\"))\n","        os.replace(CKPT_PATH + \".tmp\", CKPT_PATH)"]},{"cell_type":"markdown","id":"9d813ba0","metadata":{"papermill":{"duration":0.013393,"end_time":"2026-10-18T06:27:12.04169+00:00","exception":false,"start_time":"2026-10-18T06:27:12.028297+00:00","status":"completed"},"tags":[]},"source":["### CV runner for one dataset, feature set and model"]},{"cell_type":"code","execution_count":23,"id":"fa81fe15","metadata":{"execution":{"iopub.execute_input":"2026-10-18T06:27:12.068129Z","iopub.status.busy":"2026-10-18T06:27:12.067806Z","iopub.status.idle":"2026-10-18T06:27:12.082524Z","shell.execute_reply":"2026-10-18T06:27:12.081773Z"},"papermill":{"duration":0.030102,"end_time":"2026-10-18T06:27:12.083942+00:00","exception":false,"start_time":"2026-10-18T06:27:12.05384+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["def topk_features(X_df, y, k, seed):\n","    rf = RandomForestClassifier(n_estimators=300, max_depth=4, random_state=seed, n_jobs=2).fit(X_df.values, y)\n","    return [X_df.columns[i] for i in np.argsort(-rf.feature_importances_)[:k]]\n","\n","\n","def get_params(model, ds, fs, rep, fold, Xb, yb, Xva, yva, seed):\n","    if model in (\"XGBoost-paper\", \"TabPFN\", \"TabPFN-x32\") or CFG[\"TUNE_MODE\"] == \"none\":\n","        return DEFAULTS.get(model, {})\n","    key = (ds, fs, model, fold)\n","    if CFG[\"TUNE_MODE\"] == \"rep0\" and rep > 0 and key in CKPT[\"tuned\"]:\n","        return CKPT[\"tuned\"][key]\n","    p = tune_params(model, ds, Xb, yb, Xva, yva, seed)\n","    if CFG[\"TUNE_MODE\"] == \"rep0\" and rep == 0:\n","        CKPT[\"tuned\"][key] = p\n","    return p\n","\n","\n","def run_model_cv(ds, model, fs=\"13f\"):\n","    key = (ds, fs, model)\n","    if key in CKPT[\"rows\"]:\n","        return\n","    X, y = DS[ds]\n","    rows, preds, t0 = [], [], time.time()\n","    try:\n","        for sp in SPLITS[ds]:\n","            rep, fold = sp[\"rep\"], sp[\"fold\"]\n","            seed = CFG[\"SEED\"] + 1000 * rep + fold\n","            tr, te = np.asarray(sp[\"train\"]), np.asarray(sp[\"test\"])\n","            # imputation is fitted on the outer training fold only\n","            imp = SimpleImputer(strategy=\"most_frequent\").fit(X.iloc[tr])\n","            Xtr_all = pd.DataFrame(imp.transform(X.iloc[tr]), columns=BASE_FEATURES)\n","            Xte_all = pd.DataFrame(imp.transform(X.iloc[te]), columns=BASE_FEATURES)\n","            ytr, yte = y[tr], y[te]\n","            a, b = inner_split(ytr, seed)\n","            if fs == \"13f\":\n","                feats = BASE_FEATURES\n","            elif fs == \"paper4\":\n","                feats = FOUR_FEATURES\n","            else:   # \"top4\": chosen inside the fold, on the inner-training part only\n","                feats = topk_features(Xtr_all.iloc[a], ytr[a], int(fs[3:]), seed)\n","            Xfit, yfit = Xtr_all.iloc[a][feats].values.astype(\"float32\"), ytr[a]\n","            Xva, yva = Xtr_all.iloc[b][feats].values.astype(\"float32\"), ytr[b]\n","            Xte = Xte_all[feats].values.astype(\"float32\")\n","            Xb, yb = balance(Xfit, yfit, seed)\n","            globals()[\"CURRENT_FEATS\"] = list(feats)\n","            params = get_params(model, ds, fs, rep, fold, Xb, yb, Xva, yva, seed)\n","            m = make_model(model, params, seed, ds, CFG[\"ENS_SEEDS\"]).fit(Xb, yb, Xva, yva)\n","            p_va, p_te = m.predict_proba(Xva), m.predict_proba(Xte)\n","            met = all_metrics(yte, p_te)\n","            rows.append(dict(dataset=ds, fset=fs, model=model, rep=rep, fold=fold, kind=\"model\", n_feat=len(feats),\n","                             params=json.dumps(params, default=float), features=json.dumps(feats), **met))\n","            preds.append(dict(rep=rep, fold=fold, te_idx=te, y=yte, p=p_te, y_va=yva, p_va=p_va, feats=feats))\n","    except Exception as e:\n","        print(f\"  !! SKIPPED {ds}/{fs}/{model}: {type(e).__name__}: {str(e)[:160]}\")\n","        return\n","    CKPT[\"rows\"][key], CKPT[\"preds\"][key] = rows, preds\n","    _save_ckpt()\n","    r = pd.DataFrame(rows)\n","    print(f\"  {ds:7s} {fs:7s} {model:15s} BalAcc={r.BalAcc.mean():.3f} AUC={r.AUC.mean():.3f}  ({time.time() - t0:.0f}s)\")\n","\n","\n","def results_df():\n","    rows = [r for v in CKPT[\"rows\"].values() for r in v]\n","    return pd.DataFrame(rows)"]},{"cell_type":"markdown","id":"36a47fd6","metadata":{"papermill":{"duration":0.012268,"end_time":"2026-10-18T06:27:12.10915+00:00","exception":false,"start_time":"2026-10-18T06:27:12.096882+00:00","status":"completed"},"tags":[]},"source":["## Run the repeated CV for every dataset, feature set and model"]},{"cell_type":"code","execution_count":24,"id":"e3d8a11d","metadata":{"execution":{"iopub.execute_input":"2026-10-18T06:27:12.137639Z","iopub.status.busy":"2026-10-18T06:27:12.136913Z","iopub.status.idle":"2026-10-18T11:04:43.430527Z","shell.execute_reply":"2026-10-18T11:04:43.429718Z"},"papermill":{"duration":16651.324735,"end_time":"2026-10-18T11:04:43.446943+00:00","exception":false,"start_time":"2026-10-18T06:27:12.122208+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["  Poland  13f     XGBoost-paper   BalAcc=0.868 AUC=0.938  (2s)\n","  Poland  13f     MLP             BalAcc=0.876 AUC=0.949  (138s)\n","  Poland  13f     MLP-PLE         BalAcc=0.868 AUC=0.940  (116s)\n","  Poland  13f     MLP-PLR         BalAcc=0.874 AUC=0.945  (136s)\n","  Poland  13f     FT-Transformer  BalAcc=0.872 AUC=0.942  (298s)\n"]},{"data":{"application/vnd.jupyter.widget-view+json":{"model_id":"55bf4c6aadec487ebf05acd3e0396046","version_major":2,"version_minor":0},"text/plain":["tabpfn-v2-classifier-finetuned-zk73skhh.(…):   0%|          | 0.00/29.0M [00:00<?, ?B/s]"]},"metadata":{},"output_type":"display_data"},{"data":{"application/vnd.jupyter.widget-view+json":{"model_id":"1a912500a7304a65bc30d2860e3683d4","version_major":2,"version_minor":0},"text/plain":["config.json:   0%|          | 0.00/37.0 [00:00<?, ?B/s]"]},"metadata":{},"output_type":"display_data"},{"name":"stdout","output_type":"stream","text":["  Poland  13f     TabPFN          BalAcc=0.871 AUC=0.947  (25s)\n","  Poland  top4    XGBoost-paper   BalAcc=0.840 AUC=0.893  (17s)\n","  Poland  top4    MLP             BalAcc=0.845 AUC=0.895  (112s)\n","  Poland  top4    MLP-PLE         BalAcc=0.846 AUC=0.893  (101s)\n","  Poland  top4    MLP-PLR         BalAcc=0.844 AUC=0.894  (121s)\n","  Poland  top4    FT-Transformer  BalAcc=0.856 AUC=0.895  (302s)\n","  Poland  top4    TabPFN          BalAcc=0.845 AUC=0.894  (40s)\n","  Poland  paper4  XGBoost-paper   BalAcc=0.861 AUC=0.908  (1s)\n","  Poland  paper4  MLP             BalAcc=0.862 AUC=0.908  (104s)\n","  Poland  paper4  MLP-PLE         BalAcc=0.864 AUC=0.907  (121s)\n","  Poland  paper4  MLP-PLR         BalAcc=0.857 AUC=0.907  (129s)\n","  Poland  paper4  FT-Transformer  BalAcc=0.860 AUC=0.905  (300s)\n","  Poland  paper4  TabPFN          BalAcc=0.859 AUC=0.908  (24s)\n","  NZ      13f     XGBoost-paper   BalAcc=0.993 AUC=1.000  (2s)\n","  NZ      13f     MLP             BalAcc=1.000 AUC=1.000  (826s)\n","  NZ      13f     MLP-PLE         BalAcc=1.000 AUC=1.000  (773s)\n","  NZ      13f     MLP-PLR         BalAcc=1.000 AUC=1.000  (879s)\n","  NZ      13f     FT-Transformer  BalAcc=1.000 AUC=1.000  (4508s)\n","  NZ      13f     TabPFN          BalAcc=1.000 AUC=1.000  (25s)\n","  NZ      top4    XGBoost-paper   BalAcc=0.894 AUC=0.952  (19s)\n","  NZ      top4    MLP             BalAcc=0.897 AUC=0.953  (270s)\n","  NZ      top4    MLP-PLE         BalAcc=0.898 AUC=0.953  (294s)\n","  NZ      top4    MLP-PLR         BalAcc=0.895 AUC=0.954  (362s)\n","  NZ      top4    FT-Transformer  BalAcc=0.893 AUC=0.953  (1498s)\n","  NZ      top4    TabPFN          BalAcc=0.897 AUC=0.953  (88s)\n","  Saudi   13f     XGBoost-paper   BalAcc=0.987 AUC=0.999  (2s)\n","  Saudi   13f     MLP             BalAcc=0.994 AUC=1.000  (363s)\n","  Saudi   13f     MLP-PLE         BalAcc=0.999 AUC=1.000  (529s)\n","  Saudi   13f     MLP-PLR         BalAcc=0.998 AUC=1.000  (563s)\n","  Saudi   13f     FT-Transformer  BalAcc=0.997 AUC=1.000  (2191s)\n","  Saudi   13f     TabPFN          BalAcc=0.998 AUC=1.000  (22s)\n","  Saudi   top4    XGBoost-paper   BalAcc=0.902 AUC=0.981  (18s)\n","  Saudi   top4    MLP             BalAcc=0.903 AUC=0.980  (183s)\n","  Saudi   top4    MLP-PLE         BalAcc=0.912 AUC=0.981  (183s)\n","  Saudi   top4    MLP-PLR         BalAcc=0.909 AUC=0.980  (188s)\n","  Saudi   top4    FT-Transformer  BalAcc=0.909 AUC=0.979  (730s)\n","  Saudi   top4    TabPFN          BalAcc=0.904 AUC=0.981  (50s)\n","done in 277.5 min\n"]}],"source":["if RUN_A:\n","    t_all = time.time()\n","    for ds in DS:\n","        for fs in FEATURE_SETS[ds]:\n","            for model in CFG[\"MODELS\"]:\n","                run_model_cv(ds, model, fs)\n","    print(f\"done in {(time.time() - t_all) / 60:.1f} min\")"]},{"cell_type":"markdown","id":"5e1c012c","metadata":{"papermill":{"duration":0.014526,"end_time":"2026-10-18T11:04:43.476909+00:00","exception":false,"start_time":"2026-10-18T11:04:43.462383+00:00","status":"completed"},"tags":[]},"source":["## DL ensembles and the validation-chosen threshold\n","Two ensembles are formed from the stored out-of-fold predictions: the mean of all DL models and the mean of the top 3 by validation AUC."]},{"cell_type":"code","execution_count":25,"id":"16857549","metadata":{"execution":{"iopub.execute_input":"2026-10-18T11:04:43.50662Z","iopub.status.busy":"2026-10-18T11:04:43.506013Z","iopub.status.idle":"2026-10-18T11:04:43.516816Z","shell.execute_reply":"2026-10-18T11:04:43.51613Z"},"papermill":{"duration":0.027613,"end_time":"2026-10-18T11:04:43.518412+00:00","exception":false,"start_time":"2026-10-18T11:04:43.490799+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["def _blend_rows(ds, fs, name, recs_list):\n","    rows, preds = [], []\n","    for recs in zip(*recs_list):\n","        r0 = recs[0]\n","        assert all(r[\"rep\"] == r0[\"rep\"] and r[\"fold\"] == r0[\"fold\"] for r in recs)\n","        p = np.mean([r[\"p\"] for r in recs], 0)\n","        p_va = np.mean([r[\"p_va\"] for r in recs], 0)\n","        rows.append(dict(dataset=ds, fset=fs, model=name, rep=r0[\"rep\"], fold=r0[\"fold\"], kind=\"ensemble\", n_feat=len(r0[\"feats\"]),\n","                         params=\"\", features=json.dumps(r0[\"feats\"]), **all_metrics(r0[\"y\"], p)))\n","        preds.append(dict(rep=r0[\"rep\"], fold=r0[\"fold\"], te_idx=r0[\"te_idx\"], y=r0[\"y\"], p=p, y_va=r0[\"y_va\"], p_va=p_va, feats=r0[\"feats\"]))\n","    return rows, preds\n","\n","\n","def add_dl_ensembles(ds, fs):\n","    have = [m for m in DL_MODELS if (ds, fs, m) in CKPT[\"preds\"]]\n","    if len(have) < 2:\n","        return\n","    plans = {\"DL Ensemble (all)\": have}\n","    # per-fold top-3 by validation AUC (validation data only)\n","    top3_rows, top3_preds = [], []\n","    n_folds = len(CKPT[\"preds\"][(ds, fs, have[0])])\n","    for i in range(n_folds):\n","        recs = [CKPT[\"preds\"][(ds, fs, m)][i] for m in have]\n","        order = np.argsort([-roc_auc_score(r[\"y_va\"], r[\"p_va\"]) for r in recs])[:min(3, len(recs))]\n","        rr, pp = _blend_rows(ds, fs, \"DL Ensemble (top3 by val AUC)\", [[recs[j]] for j in order])\n","        top3_rows += rr\n","        top3_preds += pp\n","    for name, members in plans.items():   # always recomputed (cheap), so the stored validation predictions are the blended ones\n","        rows, preds = _blend_rows(ds, fs, name, [CKPT[\"preds\"][(ds, fs, m)] for m in members])\n","        CKPT[\"rows\"][(ds, fs, name)], CKPT[\"preds\"][(ds, fs, name)] = rows, preds\n","    CKPT[\"rows\"][(ds, fs, \"DL Ensemble (top3 by val AUC)\")] = top3_rows\n","    CKPT[\"preds\"][(ds, fs, \"DL Ensemble (top3 by val AUC)\")] = top3_preds"]},{"cell_type":"markdown","id":"8808e471","metadata":{"papermill":{"duration":0.01384,"end_time":"2026-10-18T11:04:43.546916+00:00","exception":false,"start_time":"2026-10-18T11:04:43.533076+00:00","status":"completed"},"tags":[]},"source":["### Build the ensembles"]},{"cell_type":"code","execution_count":26,"id":"6c51c3f2","metadata":{"execution":{"iopub.execute_input":"2026-10-18T11:04:43.576023Z","iopub.status.busy":"2026-10-18T11:04:43.575495Z","iopub.status.idle":"2026-10-18T11:04:46.306887Z","shell.execute_reply":"2026-10-18T11:04:46.306017Z"},"papermill":{"duration":2.747894,"end_time":"2026-10-18T11:04:46.308757+00:00","exception":false,"start_time":"2026-10-18T11:04:43.560863+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["if RUN_A:\n","    for ds in DS:\n","        for fs in FEATURE_SETS[ds]:\n","            add_dl_ensembles(ds, fs)\n","    _save_ckpt()"]},{"cell_type":"markdown","id":"d696019a","metadata":{"papermill":{"duration":0.015921,"end_time":"2026-10-18T11:04:46.339383+00:00","exception":false,"start_time":"2026-10-18T11:04:46.323462+00:00","status":"completed"},"tags":[]},"source":["### Collect all fold results"]},{"cell_type":"code","execution_count":27,"id":"49d9fdcc","metadata":{"execution":{"iopub.execute_input":"2026-10-18T11:04:46.372939Z","iopub.status.busy":"2026-10-18T11:04:46.372445Z","iopub.status.idle":"2026-10-18T11:04:46.395314Z","shell.execute_reply":"2026-10-18T11:04:46.394473Z"},"papermill":{"duration":0.041921,"end_time":"2026-10-18T11:04:46.397037+00:00","exception":false,"start_time":"2026-10-18T11:04:46.355116+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["if RUN_A:\n","    RES = results_df()\n","    RES = RES[RES.model.isin(BASELINES + DL_MODELS + [\"DL Ensemble (all)\", \"DL Ensemble (top3 by val AUC)\"])].reset_index(drop=True)   # only the models of this study\n","    ENSEMBLES = [\"DL Ensemble (all)\", \"DL Ensemble (top3 by val AUC)\"]\n","    DL_ALL = [m for m in DL_MODELS + ENSEMBLES if m in set(RES.model)]"]},{"cell_type":"markdown","id":"bdab8a21","metadata":{"papermill":{"duration":0.014251,"end_time":"2026-10-18T11:04:46.426704+00:00","exception":false,"start_time":"2026-10-18T11:04:46.412453+00:00","status":"completed"},"tags":[]},"source":["### Threshold chosen on the inner validation split (never on test data)"]},{"cell_type":"code","execution_count":28,"id":"855faf4a","metadata":{"execution":{"iopub.execute_input":"2026-10-18T11:04:46.456328Z","iopub.status.busy":"2026-10-18T11:04:46.455666Z","iopub.status.idle":"2026-10-18T11:04:46.463113Z","shell.execute_reply":"2026-10-18T11:04:46.462338Z"},"papermill":{"duration":0.024085,"end_time":"2026-10-18T11:04:46.464638+00:00","exception":false,"start_time":"2026-10-18T11:04:46.440553+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["def _balacc_at(y, p, t):\n","    tn, fp, fn, tp = confusion_matrix(y, (np.asarray(p) >= t).astype(int), labels=[0, 1]).ravel()\n","    return (tp / max(tp + fn, 1) + tn / max(tn + fp, 1)) / 2\n","\n","\n","def _best_thr(y, p, lo=0.30, hi=0.70):\n","    \"\"\"Threshold maximising balanced accuracy on the INNER VALIDATION split only (median of ties, restricted to [lo, hi]).\"\"\"\n","    grid = np.round(np.arange(lo, hi + 1e-9, 0.01), 2)\n","    sc = np.array([_balacc_at(y, p, t) for t in grid])\n","    return float(np.median(grid[sc >= sc.max() - 1e-12]))"]},{"cell_type":"markdown","id":"c81143a4","metadata":{"papermill":{"duration":0.01405,"end_time":"2026-10-18T11:04:46.492937+00:00","exception":false,"start_time":"2026-10-18T11:04:46.478887+00:00","status":"completed"},"tags":[]},"source":["### Apply the validation-chosen threshold to the test folds"]},{"cell_type":"code","execution_count":29,"id":"0511b961","metadata":{"execution":{"iopub.execute_input":"2026-10-18T11:04:46.523425Z","iopub.status.busy":"2026-10-18T11:04:46.522926Z","iopub.status.idle":"2026-10-18T11:05:20.642133Z","shell.execute_reply":"2026-10-18T11:05:20.64123Z"},"papermill":{"duration":34.151154,"end_time":"2026-10-18T11:05:20.658077+00:00","exception":false,"start_time":"2026-10-18T11:04:46.506923+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["models in results: ['DL Ensemble (all)', 'DL Ensemble (top3 by val AUC)', 'FT-Transformer', 'MLP', 'MLP-PLE', 'MLP-PLR', 'TabPFN', 'XGBoost-paper']\n"]}],"source":["if RUN_A:\n","    VALTHR = {}\n","    for _k, _plist in CKPT[\"preds\"].items():\n","        for _r in _plist:\n","            _t = _best_thr(_r[\"y_va\"], _r[\"p_va\"])\n","            VALTHR[(_k[0], _k[1], _k[2], _r[\"rep\"], _r[\"fold\"])] = (_t, _balacc_at(_r[\"y\"], _r[\"p\"], _t))\n","    _look = [VALTHR.get((d, f, m, rp, fo), (np.nan, np.nan)) for d, f, m, rp, fo in zip(RES.dataset, RES.fset, RES.model, RES.rep, RES.fold)]\n","    RES[\"thr_val\"] = [x[0] for x in _look]\n","    RES[\"BalAcc_valthr\"] = [x[1] for x in _look]   # test balanced accuracy at the validation-chosen threshold (same rule for every model)\n","    print(\"models in results:\", sorted(set(RES.model)))"]},{"cell_type":"markdown","id":"a5b350f4","metadata":{"papermill":{"duration":0.01396,"end_time":"2026-10-18T11:05:20.68815+00:00","exception":false,"start_time":"2026-10-18T11:05:20.67419+00:00","status":"completed"},"tags":[]},"source":["## Table 1: mean ± std over all repeated folds"]},{"cell_type":"code","execution_count":30,"id":"79914c63","metadata":{"execution":{"iopub.execute_input":"2026-10-18T11:05:20.720551Z","iopub.status.busy":"2026-10-18T11:05:20.720066Z","iopub.status.idle":"2026-10-18T11:05:20.794312Z","shell.execute_reply":"2026-10-18T11:05:20.793566Z"},"papermill":{"duration":0.092677,"end_time":"2026-10-18T11:05:20.796726+00:00","exception":false,"start_time":"2026-10-18T11:05:20.704049+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["\n","=== NZ | feature set 13f ===\n","                                      BalAcc  BalAcc_valthr        AUC      PRAUC Sens_at_90Spec           Sens           Spec          Brier            ECE\n","model                                                                                                                                                       \n","XGBoost-paper                  0.993 ± 0.009  0.993 ± 0.009  1.0 ± 0.0  1.0 ± 0.0      1.0 ± 0.0  0.997 ± 0.005  0.989 ± 0.017  0.008 ± 0.003  0.031 ± 0.005\n","MLP                              1.0 ± 0.001    1.0 ± 0.001  1.0 ± 0.0  1.0 ± 0.0      1.0 ± 0.0    1.0 ± 0.001      1.0 ± 0.0      0.0 ± 0.0  0.002 ± 0.001\n","MLP-PLE                       