    KernelSHAP - LIME  0.004   0.001    0.007   0.040 KernelSHAP\n","  Saudi       MLP-PLE cos_oracle        IG - KernelSHAP -0.032  -0.038   -0.027   0.003 KernelSHAP\n","  Saudi       MLP-PLE cos_oracle              IG - LIME  0.024   0.015    0.033   0.003         IG\n","  Saudi       MLP-PLE cos_oracle      KernelSHAP - LIME  0.056   0.048    0.064   0.003 KernelSHAP\n","  Saudi        TabPFN cos_oracle      KernelSHAP - LIME  0.051   0.043    0.059   0.001 KernelSHAP\n","  Saudi XGBoost-paper   del_gain ExactSHAP - KernelSHAP  0.002   0.001    0.003   0.003  ExactSHAP\n","  Saudi XGBoost-paper   del_gain       ExactSHAP - LIME  0.002   0.001    0.004   0.003  ExactSHAP\n","  Saudi XGBoost-paper cos_oracle ExactSHAP - KernelSHAP  0.004   0.003    0.005   0.003  ExactSHAP\n","  Saudi XGBoost-paper cos_oracle       ExactSHAP - LIME  0.037   0.030    0.045   0.003  ExactSHAP\n","  Saudi XGBoost-paper cos_oracle      KernelSHAP - LIME  0.033   0.026    0.041   0.003 KernelSHAP\n"]}],"source":["if RUN_C:\n","    # ---- X7: methods compared pairwise per model ----\n","    rows = []\n","    for (ds, mdl), g in PC.groupby([\"ds\", \"model\"]):\n","        piv = {met: g.pivot_table(index=\"child\", columns=\"method\", values=met) for met in PCM}\n","        for met in PCM:\n","            P_ = piv[met]\n","            if P_.isna().all().all():\n","                continue\n","            grp = []\n","            for a, b in itertools.combinations(P_.columns, 2):\n","                d, lo, hi, p = paired_boot(P_[a].values, P_[b].values, B_)\n","                if not np.isnan(d):\n","                    grp.append(dict(dataset=ds, model=mdl, metric=met, pair=f\"{a} - {b}\", diff=d, ci_low=lo, ci_high=hi, p_boot=p))\n","            if grp:\n","                gg = pd.DataFrame(grp)\n","                gg[\"p_holm\"] = holm(gg.p_boot.values)\n","                rows.append(gg)\n","    X7 = pd.concat(rows, ignore_index=True) if rows else pd.DataFrame()\n","    X7.to_csv(os.path.join(CFG[\"OUT_DIR\"], \"xai_X7_method_pairs.csv\"), index=False)\n","    print(\"\\n=== X7  Pairwise method differences (per model, Holm within group); only pairs with Holm p < 0.05 are listed ===\")\n","    if len(X7):\n","        sig = X7[X7.p_holm < 0.05].copy()\n","        sig[\"better\"] = [(r.pair.split(\" - \")[0] if (r[\"diff\"] < 0) == (r.metric == \"sign_viol\") else r.pair.split(\" - \")[1]) for _, r in sig.iterrows()]\n","        print(sig[[\"dataset\", \"model\", \"metric\", \"pair\", \"diff\", \"ci_low\", \"ci_high\", \"p_holm\", \"better\"]].round(3).to_string(index=False) if len(sig) else \"none\")"]},{"cell_type":"markdown","id":"4ef756a5","metadata":{"papermill":{"duration":0.027924,"end_time":"2026-10-18T14:29:32.800547+00:00","exception":false,"start_time":"2026-10-18T14:29:32.772623+00:00","status":"completed"},"tags":[]},"source":["### X8: descriptive mean ranks (scoped, not a composite score)"]},{"cell_type":"code","execution_count":94,"id":"e0178a01","metadata":{"execution":{"iopub.execute_input":"2026-10-18T14:29:32.861938Z","iopub.status.busy":"2026-10-18T14:29:32.861674Z","iopub.status.idle":"2026-10-18T14:29:32.982401Z","shell.execute_reply":"2026-10-18T14:29:32.981542Z"},"papermill":{"duration":0.153225,"end_time":"2026-10-18T14:29:32.98414+00:00","exception":false,"start_time":"2026-10-18T14:29:32.830915+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["\n","=== X8  Mean rank of each method per criterion (1 = best; descriptive only; ExactSHAP speed is enumeration, not TreeSHAP speed) ===\n","\n","--- all four models: KernelSHAP vs LIME ---\n","criterion   deletion_gain  insertion_gain  resample_stability  rule_cosine  sign_violations(-)  speed(-sec)\n","method                                                                                                     \n","KernelSHAP            1.0            1.25                 2.0          1.0                1.62          2.0\n","LIME                  2.0            1.75                 1.0          2.0                1.38          1.0\n","\n","--- networks (MLP, MLP-PLE): KernelSHAP vs LIME vs IG ---\n","criterion   deletion_gain  insertion_gain  resample_stability  rule_cosine  sign_violations(-)  speed(-sec)\n","method                                                                                                     \n","IG                   2.33            2.33                 3.0          2.0                1.67          3.0\n","KernelSHAP           1.00            1.17                 2.0          1.0                2.50          2.0\n","LIME                 2.67            2.50                 1.0          3.0                1.83          1.0\n","\n","--- XGBoost: ExactSHAP vs KernelSHAP vs LIME ---\n","criterion   deletion_gain  insertion_gain  resample_stability  rule_cosine  sign_violations(-)  speed(-sec)\n","method                                                                                                     \n","ExactSHAP             1.0            1.00                 2.0          1.0                1.83          3.0\n","KernelSHAP            2.0            2.33                 3.0          2.0                1.83          2.0\n","LIME                  3.0            2.67                 1.0          3.0                2.33          1.0\n"]}],"source":["if RUN_C:\n","    # ---- X8: descriptive scoreboard (mean rank, 1 = best). Not a composite score.\n","    # A method is ranked only against the methods available in the same dataset x model cell, and the scoreboard is shown separately for three groups of\n","    # cells, so that no method is ranked in an easier field than another (ExactSHAP exists only for XGBoost, IG only for the networks).\n","    X8_GROUPS = {\"all four models: KernelSHAP vs LIME\": (lambda m: True, [\"KernelSHAP\", \"LIME\"]),\n","                 \"networks (MLP, MLP-PLE): KernelSHAP vs LIME vs IG\": (lambda m: m in (\"MLP\", \"MLP-PLE\"), [\"KernelSHAP\", \"LIME\", \"IG\"]),\n","                 \"XGBoost: ExactSHAP vs KernelSHAP vs LIME\": (lambda m: m == \"XGBoost-paper\", [\"ExactSHAP\", \"KernelSHAP\", \"LIME\"])}\n","\n","\n","    def _rank_table(sel, methods):\n","        recs = []\n","        for (ds, mdl), rec in XR.items():\n","            if not sel(mdl):\n","                continue\n","            cell = {}\n","            sub = PC[(PC.ds == ds) & (PC.model == mdl)].groupby(\"method\")[PCM].mean()\n","            for meth in sub.index:\n","                if meth not in methods:\n","                    continue\n","                cell.setdefault(\"deletion_gain\", {})[meth] = sub.loc[meth, \"del_gain\"]\n","                cell.setdefault(\"insertion_gain\", {})[meth] = sub.loc[meth, \"ins_gain\"]\n","                if RULE.get(ds, {}).get(\"use\"):\n","                    cell.setdefault(\"rule_cosine\", {})[meth] = sub.loc[meth, \"cos_oracle\"]\n","                cell.setdefault(\"sign_violations(-)\", {})[meth] = -sub.loc[meth, \"sign_viol\"]\n","                if meth in rec[\"samp\"]:\n","                    cell.setdefault(\"resample_stability\", {})[meth] = float(np.nanmean(rec[\"samp\"][meth]))\n","                if meth in rec[\"sec\"]:\n","                    cell.setdefault(\"speed(-sec)\", {})[meth] = -sum(s for s, _ in rec[\"sec\"][meth]) / max(sum(n for _, n in rec[\"sec\"][meth]), 1)\n","            for crit, d in cell.items():\n","                for meth, rk in pd.Series(d).rank(ascending=False).items():\n","                    recs.append(dict(criterion=crit, method=meth, rank=rk, cell=f\"{ds}/{mdl}\"))\n","        return pd.DataFrame(recs)\n","\n","\n","    X8_ALL = []\n","    print(\"\\n=== X8  Mean rank of each method per criterion (1 = best; descriptive only; ExactSHAP speed is enumeration, not TreeSHAP speed) ===\")\n","    for gname, (sel, methods) in X8_GROUPS.items():\n","        RK = _rank_table(sel, methods)\n","        if len(RK):\n","            t = RK.pivot_table(index=\"method\", columns=\"criterion\", values=\"rank\", aggfunc=\"mean\").round(2)\n","            print(\"\\n--- \" + gname + \" ---\")\n","            print(t.to_string())\n","            X8_ALL.append(t.assign(group=gname))\n","    if X8_ALL:\n","        pd.concat(X8_ALL).to_csv(os.path.join(CFG[\"OUT_DIR\"], \"xai_X8_mean_ranks.csv\"))"]},{"cell_type":"markdown","id":"5908a7ad","metadata":{"papermill":{"duration":0.029235,"end_time":"2026-10-18T14:29:33.043423+00:00","exception":false,"start_time":"2026-10-18T14:29:33.014188+00:00","status":"completed"},"tags":[]},"source":["## Figures (colour-blind safe palette; markers also encode the method)"]},{"cell_type":"code","execution_count":95,"id":"0b95b5b5","metadata":{"execution":{"iopub.execute_input":"2026-10-18T14:29:33.104408Z","iopub.status.busy":"2026-10-18T14:29:33.103946Z","iopub.status.idle":"2026-10-18T14:29:33.108718Z","shell.execute_reply":"2026-10-18T14:29:33.108054Z"},"papermill":{"duration":0.03752,"end_time":"2026-10-18T14:29:33.110175+00:00","exception":false,"start_time":"2026-10-18T14:29:33.072655+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["if RUN_C:\n","    plt.rcParams.update({\"axes.spines.top\": False, \"axes.spines.right\": False, \"axes.grid\": True, \"grid.alpha\": 0.25, \"font.size\": 9})\n","\n","\n","    def _save(name):\n","        plt.tight_layout()\n","        plt.savefig(os.path.join(CFG[\"OUT_DIR\"], name), dpi=200, bbox_inches=\"tight\")\n","        plt.show()"]},{"cell_type":"markdown","id":"8c79ec9e","metadata":{"papermill":{"duration":0.02916,"end_time":"2026-10-18T14:29:33.167888+00:00","exception":false,"start_time":"2026-10-18T14:29:33.138728+00:00","status":"completed"},"tags":[]},"source":["### Global importance and deletion curves"]},{"cell_type":"code","execution_count":96,"id":"71a7e9f6","metadata":{"execution":{"iopub.execute_input":"2026-10-18T14:29:33.227251Z","iopub.status.busy":"2026-10-18T14:29:33.226886Z","iopub.status.idle":"2026-10-18T14:29:35.710603Z","shell.execute_reply":"2026-10-18T14:29:35.70975Z"},"papermill":{"duration":2.516811,"end_time":"2026-10-18T14:29:35.713081+00:00","exception":false,"start_time":"2026-10-18T14:29:33.19627+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"image/png":"\n","text/plain":["<Figure size 1920x500 with 4 Axes>"]},"metadata":{},"output_type":"display_data"},{"data":{"image/png":"\n","text/plain":["<Figure size 1760x360 with 4 Axes>"]},"metadata":{},"output_type":"display_data"}],"source":["if RUN_C:\n","    MAIN = \"Poland\" if \"Poland\" in XAI_DS else XAI_DS[0]\n","    mods = [m for m in XAI_MODELS if (MAIN, m) in XR]\n","    if mods:\n","        # Fig X1: global importance\n","        fig, axes = plt.subplots(1, len(mods), figsize=(4.8 * len(mods), 5), sharey=True, squeeze=False)\n","        for ax, mdl in zip(axes[0], mods):\n","            meths = [m for m in ALL_METHODS if len(X1[(X1.dataset == MAIN) & (X1.model == mdl) & (X1.method == m)])]\n","            ref = X1[(X1.dataset == MAIN) & (X1.model == mdl) & (X1.method == meths[0])].set_index(\"feature\").importance\n","            order = np.argsort(ref.reindex(BASE_FEATURES).values)\n","            h = 0.8 / max(len(meths), 1)\n","            for k_, m in enumerate(meths):\n","                s = X1[(X1.dataset == MAIN) & (X1.model == mdl) & (X1.method == m)].set_index(\"feature\").reindex(BASE_FEATURES)\n","                pos = np.arange(NF) + (k_ - (len(meths) - 1) / 2) * h\n","                ax.barh(pos, s.importance.values[order], height=h, color=MCOL[m], label=m, edgecolor=\"white\")\n","            ax.set_yticks(np.arange(NF)); ax.set_yticklabels(np.array(SHORT)[order]); ax.set_title(mdl); ax.set_xlabel(\"share of total importance\")\n","        axes[0][0].legend(frameon=False, fontsize=7, loc=\"lower right\")\n","        fig.suptitle(f\"Global importance, {MAIN}\", y=1.02)\n","        _save(\"fig_xai_global_importance.png\")\n","\n","        # Fig X2: deletion curves\n","        fig, axes = plt.subplots(1, len(mods), figsize=(4.4 * len(mods), 3.6), sharey=True, squeeze=False)\n","        for ax, mdl in zip(axes[0], mods):\n","            rec = XR[(MAIN, mdl)]\n","            for m in [k for k in PER_CHILD + [\"RANDOM\"] if k in rec[\"fid\"]]:\n","                c = np.nanmean(rec[\"fid\"][m][\"del_curve\"], 0)\n","                ax.plot(range(NF + 1), c, color=MCOL[m], marker=MMARK[m], ms=3, lw=1.5, ls=\"--\" if m == \"RANDOM\" else \"-\", label=m)\n","            ax.set_title(mdl); ax.set_xlabel(\"features deleted (most supportive first)\")\n","        axes[0][0].set_ylabel(\"P(predicted class)\"); axes[0][0].legend(frameon=False, fontsize=7)\n","        fig.suptitle(f\"Deletion test, {MAIN}: faster drop than random = more faithful\", y=1.03)\n","        _save(\"fig_xai_deletion.png\")"]},{"cell_type":"markdown","id":"b4a40d77","metadata":{"papermill":{"duration":0.030931,"end_time":"2026-10-18T14:29:35.775818+00:00","exception":false,"start_time":"2026-10-18T14:29:35.744887+00:00","status":"completed"},"tags":[]},"source":["### Rule recovery (NZ and Saudi)"]},{"cell_type":"code","execution_count":97,"id":"51d7bde8","metadata":{"execution":{"iopub.execute_input":"2026-10-18T14:29:35.839088Z","iopub.status.busy":"2026-10-18T14:29:35.83857Z","iopub.status.idle":"2026-10-18T14:29:37.33702Z","shell.execute_reply":"2026-10-18T14:29:37.336159Z"},"papermill":{"duration":1.532646,"end_time":"2026-10-18T14:29:37.338812+00:00","exception":false,"start_time":"2026-10-18T14:29:35.806166+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"image/png":"\n","text/plain":["<Figure size 1000x680 with 4 Axes>"]},"metadata":{},"output_type":"display_data"}],"source":["if RUN_C:\n","    # Fig X3: rule recovery (NZ / Saudi)\n","    rule_ds = [d for d in XAI_DS if RULE.get(d, {}).get(\"use\") and len(X2[X2.dataset == d])]\n","    if rule_ds:\n","        fig, axes = plt.subplots(len(rule_ds), 2, figsize=(10, 3.4 * len(rule_ds)), squeeze=False)\n","        for i, ds in enumerate(rule_ds):\n","            for j, (col, ttl) in enumerate([(\"cos_oracle\", \"cosine to exact rule-Shapley values (higher = better)\"), (\"sign_viol\", \"sign violations (lower = better)\")]):\n","                ax = axes[i][j]\n","                sub = X2[(X2.dataset == ds)].dropna(subset=[col])\n","                ms = [m for m in XAI_MODELS if m in set(sub.model)]\n","                meths = [m for m in PER_CHILD if m in set(sub.method)]\n","                w = 0.8 / max(len(meths), 1)\n","                for k_, m in enumerate(meths):\n","                    s = sub[sub.method == m].set_index(\"model\").reindex(ms)\n","                    x = np.arange(len(ms)) + (k_ - (len(meths) - 1) / 2) * w\n","                    ax.bar(x, s[col].values, width=w, color=MCOL[m], label=m, edgecolor=\"white\",\n","                           yerr=[np.clip(s[col].values - s[col + \"_lo\"].values, 0, None), np.clip(s[col + \"_hi\"].values - s[col].values, 0, None)], error_kw=dict(lw=0.8))\n","                ax.set_xticks(np.arange(len(ms))); ax.set_xticklabels(ms); ax.set_title(f\"{ds}: {ttl}\", fontsize=8)\n","        axes[0][0].legend(frameon=False, fontsize=7)\n","        _save(\"fig_xai_rule_recovery.png\")"]},{"cell_type":"markdown","id":"02917cb9","metadata":{"papermill":{"duration":0.031961,"end_time":"2026-10-18T14:29:37.404325+00:00","exception":false,"start_time":"2026-10-18T14:29:37.372364+00:00","status":"completed"},"tags":[]},"source":["### Agreement heatmaps"]},{"cell_type":"code","execution_count":98,"id":"fe90306f","metadata":{"execution":{"iopub.execute_input":"2026-10-18T14:29:37.476018Z","iopub.status.busy":"2026-10-18T14:29:37.475359Z","iopub.status.idle":"2026-10-18T14:29:38.153698Z","shell.execute_reply":"2026-10-18T14:29:38.152785Z"},"papermill":{"duration":0.716076,"end_time":"2026-10-18T14:29:38.155508+00:00","exception":false,"start_time":"2026-10-18T14:29:37.439432+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"image/png":"\n","text/plain":["<Figure size 1260x380 with 3 Axes>"]},"metadata":{},"output_type":"display_data"}],"source":["if RUN_C:\n","    # Fig X4: agreement heatmaps (same child, models and methods)\n","    if len(X5b) or len(X5a):\n","        fig, axes = plt.subplots(1, len(XAI_DS), figsize=(4.2 * len(XAI_DS), 3.8), squeeze=False)\n","        for ax, ds in zip(axes[0], XAI_DS):\n","            ms = [m for m in XAI_MODELS if (ds, m) in XR and \"KernelSHAP\" in XR[(ds, m)][\"attr\"][0]]\n","            M = np.full((len(ms), len(ms)), np.nan)\n","            for a, b in itertools.product(range(len(ms)), range(len(ms))):\n","                M[a, b] = np.nanmean(cos_rows(XR[(ds, ms[a])][\"attr\"][0][\"KernelSHAP\"], XR[(ds, ms[b])][\"attr\"][0][\"KernelSHAP\"]))\n","            ax.imshow(M, vmin=0, vmax=1, cmap=\"Blues\")\n","            ax.set_xticks(range(len(ms))); ax.set_xticklabels(ms, rotation=30, ha=\"right\", fontsize=7); ax.set_yticks(range(len(ms))); ax.set_yticklabels(ms, fontsize=7)\n","            for a, b in itertools.product(range(len(ms)), range(len(ms))):\n","                ax.text(b, a, f\"{M[a, b]:.2f}\", ha=\"center\", va=\"center\", fontsize=7)\n","            ax.set_title(ds); ax.grid(False)\n","        fig.suptitle(\"Do the models explain a child alike? per-child cosine of KernelSHAP attributions\", y=1.04)\n","        _save(\"fig_xai_model_agreement.png\")"]},{"cell_type":"markdown","id":"17cb9fe9","metadata":{"papermill":{"duration":0.0311,"end_time":"2026-10-18T14:29:38.220096+00:00","exception":false,"start_time":"2026-10-18T14:29:38.188996+00:00","status":"completed"},"tags":[]},"source":["### Stability and cost"]},{"cell_type":"code","execution_count":99,"id":"4a1f5a30","metadata":{"execution":{"iopub.execute_input":"2026-10-18T14:29:38.287282Z","iopub.status.busy":"2026-10-18T14:29:38.286836Z","iopub.status.idle":"2026-10-18T14:29:39.034824Z","shell.execute_reply":"2026-10-18T14:29:39.034049Z"},"papermill":{"duration":0.784604,"end_time":"2026-10-18T14:29:39.036505+00:00","exception":false,"start_time":"2026-10-18T14:29:38.251901+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"image/png":"\n","text/plain":["<Figure size 1000x360 with 2 Axes>"]},"metadata":{},"output_type":"display_data"}],"source":["if RUN_C:\n","    # Fig X5: stability and cost\n","    if len(X4):\n","        fig, axes = plt.subplots(1, 2, figsize=(10, 3.6))\n","        s4 = X4.copy()\n","        s4[\"rs\"] = s4.resample_stability.map(lambda t: float(str(t).split(\" \")[0]) if isinstance(t, str) else np.nan) if \"resample_stability\" in s4 else np.nan\n","        g = s4.groupby(\"method\")[\"rs\"].mean().reindex([m for m in PER_CHILD if m in set(s4.method)])\n","        axes[0].bar(range(len(g)), g.values, color=[MCOL[m] for m in g.index]); axes[0].set_xticks(range(len(g))); axes[0].set_xticklabels(g.index)\n","        axes[0].set_ylabel(\"cosine between repeated runs\"); axes[0].set_title(\"Stability under explainer re-sampling (mean over cells)\")\n","        if \"sec_per_child\" in s4:\n","            t = s4.groupby(\"method\")[\"sec_per_child\"].mean().reindex([m for m in PER_CHILD if m in set(s4.method)])\n","            axes[1].bar(range(len(t)), t.values, color=[MCOL[m] for m in t.index]); axes[1].set_xticks(range(len(t))); axes[1].set_xticklabels(t.index)\n","            axes[1].set_yscale(\"log\"); axes[1].set_ylabel(\"seconds per explained child\"); axes[1].set_title(\"Cost\")\n","        _save(\"fig_xai_stability_cost.png\")"]},{"cell_type":"markdown","id":"da005ab6","metadata":{"papermill":{"duration":0.033451,"end_time":"2026-10-18T14:29:39.104711+00:00","exception":false,"start_time":"2026-10-18T14:29:39.07126+00:00","status":"completed"},"tags":[]},"source":["### One child explained by every method"]},{"cell_type":"code","execution_count":100,"id":"22f5edf9","metadata":{"execution":{"iopub.execute_input":"2026-10-18T14:29:39.174058Z","iopub.status.busy":"2026-10-18T14:29:39.173594Z","iopub.status.idle":"2026-1