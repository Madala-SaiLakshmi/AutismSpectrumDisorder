(CFG[\"OUT_DIR\"], \"xai_X6_dl_vs_xgboost.csv\"), index=False)\n","    print(X6.round(3).to_string(index=False) if len(X6) else \"(no paired comparisons available)\")"]},{"cell_type":"markdown","id":"8af1c15e","metadata":{"papermill":{"duration":0.029502,"end_time":"2026-10-18T14:29:32.042135+00:00","exception":false,"start_time":"2026-10-18T14:29:32.012633+00:00","status":"completed"},"tags":[]},"source":["### X7: pairwise differences between methods (Holm within group)"]},{"cell_type":"code","execution_count":93,"id":"941bf556","metadata":{"execution":{"iopub.execute_input":"2026-10-18T14:29:32.099571Z","iopub.status.busy":"2026-10-18T14:29:32.09877Z","iopub.status.idle":"2026-10-18T14:29:32.738884Z","shell.execute_reply":"2026-10-18T14:29:32.738154Z"},"papermill":{"duration":0.670845,"end_time":"2026-10-18T14:29:32.741233+00:00","exception":false,"start_time":"2026-10-18T14:29:32.070388+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["\n","=== X7  Pairwise method differences (per model, Holm within group); only pairs with Holm p < 0.05 are listed ===\n","dataset         model     metric                   pair   diff  ci_low  ci_high  p_holm     better\n","     NZ           MLP   del_gain        IG - KernelSHAP -0.008  -0.012   -0.004   0.003 KernelSHAP\n","     NZ           MLP   del_gain      KernelSHAP - LIME  0.010   0.005    0.014   0.003 KernelSHAP\n","     NZ           MLP cos_oracle        IG - KernelSHAP -0.020  -0.023   -0.017   0.003 KernelSHAP\n","     NZ           MLP cos_oracle              IG - LIME  0.055   0.048    0.061   0.003         IG\n","     NZ           MLP cos_oracle      KernelSHAP - LIME  0.075   0.067    0.082   0.003 KernelSHAP\n","     NZ       MLP-PLE   del_gain        IG - KernelSHAP -0.010  -0.015   -0.006   0.003 KernelSHAP\n","     NZ       MLP-PLE   del_gain      KernelSHAP - LIME  0.011   0.006    0.016   0.003 KernelSHAP\n","     NZ       MLP-PLE   ins_gain        IG - Kernel