               r[\"retrain_stability\"] = fmt_ci(boot_mean(np.nanmean(np.stack(cs), 0), B_))\n","            if meth in rec[\"sec\"]:\n","                tot = sum(s for s, _ in rec[\"sec\"][meth])\n","                cnt = sum(n for _, n in rec[\"sec\"][meth])\n","                r[\"sec_per_child\"] = tot / max(cnt, 1)\n","            if meth in rec[\"diag\"]:\n","                d = np.concatenate(rec[\"diag\"][meth])\n","                r[\"diagnostic\"] = {\"KernelSHAP\": f\"additivity error {d.mean():.4f}\", \"IG\": f\"completeness error {d.mean():.4f}\",\n","                                   \"LIME\": f\"surrogate R2 {d.mean():.3f}\"}.get(meth, \"\")\n","            if len(r) > 3:\n","                rows.append(r)\n","    X4 = pd.DataFrame(rows)\n","    X4.to_csv(os.path.join(CFG[\"OUT_DIR\"], \"xai_X4_stability_cost.csv\"), index=False)\n","    print(X4.to_string(index=False))\n","    if XCFG[\"N_REP\"] < 2:\n","        print(\"(retrain stability needs at least 2 CV repeats: use preset 'standard' or 'full')\")"]},{"cell_type":"markdown","id":"e26bc450","metadata":{"papermill":{"duration":0.026997,"end_time":"2026-10-18T14:29:31.256294+00:00","exception":false,"start_time":"2026-10-18T14:29:31.229297+00:00","status":"completed"},"tags":[]},"source":["### X5a: agreement between methods for the same model"]},{"cell_type":"code","execution_count":90,"id":"d537543f","metadata":{"execution":{"iopub.execute_input":"2026-10-18T14:29:31.314451Z","iopub.status.busy":"2026-10-18T14:29:31.314192Z","iopub.status.idle":"2026-10-18T14:29:31.479446Z","shell.execute_reply":"2026-10-18T14:29:31.47851Z"},"papermill":{"duration":0.195697,"end_time":"2026-10-18T14:29:31.481118+00:00","exception":false,"start_time":"2026-10-18T14:29:31.285421+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["\n","=== X5a  Agreement between methods for the same model: mean per-child cosine (signed attributions) and rank correlation of global impo