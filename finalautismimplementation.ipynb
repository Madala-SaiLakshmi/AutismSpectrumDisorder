metadata":{"papermill":{"duration":0.014772,"end_time":"2026-10-18T11:05:20.82658+00:00","exception":false,"start_time":"2026-10-18T11:05:20.811808+00:00","status":"completed"},"tags":[]},"source":["## Statistical comparison of every DL technique with XGBoost\n","Paired differences on identical folds with the Nadeau-Bengio corrected resampled t-test (repeated CV folds are not independent), Holm correction across models, 95% CI, and TOST equivalence (margin ±0.02 for AUC and balanced accuracy, ±0.05 for sensitivity at 90% specificity). Verdicts: SIGNIFICANTLY BETTER / WORSE, EQUIVALENT, or inconclusive."]},{"cell_type":"code","execution_count":31,"id":"5254883e","metadata":{"execution":{"iopub.execute_input":"2026-10-18T11:05:20.858354Z","iopub.status.busy":"2026-10-18T11:05:20.857808Z","iopub.status.idle":"2026-10-18T11:05:20.868862Z","shell.execute_reply":"2026-10-18T11:05:20.868217Z"},"papermill":{"duration":0.02894,"end_time":"2026-10-18T11:05:20.870453+00:00","exception":false,"start_time":"2026-10-18T11:05:20.841513+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["HIGHER_BETTER = {\"BalAcc\": True, \"BalAcc_valthr\": True, \"AUC\": True, \"PRAUC\": True, \"Sens_at_90Spec\": True, \"Brier\": False}\n","\n","\n","def compare_to_ref(res, ds, fs, metric, ref):\n","    \"\"\"diff = model - ref over matched (repeat, fold) pairs; Nadeau-Bengio corrected variance; TOST via the 90% CI.\"\"\"\n","    sub = res[(res.dataset == ds) & (res.fset == fs)]\n","    piv = sub.pivot_table(index=[\"rep\", \"fold\"], columns=\"model\", values=metric)\n","    if ref not in piv:\n","        return pd.DataFrame()\n","    delta = CFG[\"DELTA\"][metric]\n","    ratio = 1.0 / (CFG[\"N_SPLITS\"] - 1)\n","    out = []\n","    for m in piv.columns:\n","        if m == ref:\n","            continue\n","        d = (piv[m] - piv[ref]).dropna().values\n","        if len(d) < 3:\n","            continue\n","        se = math.sqrt((1 / len(d) + ratio) * d.var(ddof=1))\n","        t = d.mean() / se if se > 0 else 0.0\n","        p_nb = 2 * stats.t.sf(abs(t), len(d) - 1) if se > 0 else 1.0\n","        h95, h90 = stats.t.ppf(0.975, len(d) - 1) * se, stats.t.ppf(0.95, len(d) - 1) * se\n","        out.append(dict(dataset=ds, fset=fs, metric=metric, model=m, ref=ref, mean_model=piv[m].mean(), mean_ref=piv[ref].mean(),\n","                        diff=d.mean(), ci95_low=d.mean() - h95, ci95_high=d.mean() + h95, p_NB=p_nb,\n","                        equivalent=bool(d.mean() - h90 > -delta and d.mean() + h90 < delta), delta=delta, n=len(d)))\n","    df = pd.DataFrame(out)\n","    if len(df):\n","        df[\"p_holm\"] = holm(df[\"p_NB\"].values)\n","        better = (df[\"diff\"] > 0) if HIGHER_BETTER[metric] else (df[\"diff\"] < 0)\n","\n","        def verdict(r, b):\n","            if r[\"equivalent\"]:\n","                return f\"EQUIVALENT (within ±{r['delta']:.2f})\"\n","            if r[\"p_holm\"] < 0.05:\n","                return \"SIGNIFICANTLY BETTER\" if b else \"SIGNIFICANTLY WORSE\"\n","            return \"inconclusive (higher mean)\" if b else \"inconclusive (lower mean)\"\n","        df[\"verdict\"] = [verdict(r, b) for (_, r), b in zip(df.iterrows(), better)]\n","    return df\n","\n","\n","def full_comparison(res, metrics=(\"BalAcc\", \"BalAcc_valthr\", \"AUC\", \"Sens_at_90Spec\", \"Brier\")):\n","    parts = [compare_to_ref(res, ds, fs, m, ref) for ds in DS for fs in FEATURE_SETS[ds] for m in metrics for ref in CFG[\"REFS\"]]\n","    parts = [p for p in parts if len(p)]\n","    return pd.concat(parts, ignore_index=True) if parts else pd.DataFrame()"]},{"cell_type":"markdown","id":"3c002bd3","metadata":{"papermill":{"duration":0.013966,"end_time":"2026-10-18T11:05:20.898367+00:00","exception":false,"start_time":"2026-10-18T11:05:20.884401+00:00","status":"completed"},"tags":[]},"source":["### Run the comparisons"]},{"cell_type":"code","execution_count":32,"id":"ca4f0e2a","metadata":{"execution":{"iopub.execute_input":"2026-10-18