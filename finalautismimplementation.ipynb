s, b)][\"attr\"][0][\"KernelSHAP\"]\n","            rows.append(dict(dataset=ds, pair=f\"{a} vs {b}\", per_child_cosine=fmt_ci(boot_mean(cos_rows(A, Bm), B_)),\n","                             global_spearman=spearman_safe(global_vec(XR[(ds, a)], \"KernelSHAP\"), global_vec(XR[(ds, b)], \"KernelSHAP\"))))\n","    X5b = pd.DataFrame(rows)\n","    X5b.to_csv(os.path.join(CFG[\"OUT_DIR\"], \"xai_X5b_model_agreement.csv\"), index=False)\n","    print(X5b.round(3).to_string(index=False))\n","    for ds in XAI_DS:\n","        r = XR.get((ds, \"XGBoost-paper\"))\n","        if r and \"ExactSHAP\" in r[\"attr\"][0] and \"KernelSHAP\" in r[\"attr\"][0]:\n","            c = cos_rows(r[\"attr\"][0][\"KernelSHAP\"], r[\"attr\"][0][\"ExactSHAP\"])\n","            print(f\"check ({ds}): KernelSHAP vs exact Shapley on XGBoost-paper, mean per-child cosine = {np.nanmean(c):.3f} (should be close to 1)\")"]},{"cell_type":"markdown","id":"185a9b88","metadata":{"papermill":{"duration":0.027688,"end_time":"2026-10-18T14:29:31.744393+00:00","exception":false,"start_time":"2026-10-18T14:29:31.716705+00:00","status":"completed"},"tags":[]},"source":["### X6: DL minus XGBoost in explanation quality (KernelSHAP for both)"]},{"cell_type":"code","execution_count":92,"id":"7cb7a663","metadata":{"execution":{"iopub.execute_input":"2026-10-18T14:29:31.799925Z","iopub.status.busy":"2026-10-18T14:29:31.799327Z","iopub.status.idle":"2026-10-18T14:29:31.981642Z","shell.execute_reply":"2026-10-18T14:29:31.98042Z"},"papermill":{"duration":0.212061,"end_time":"2026-10-18T14:29:31.983396+00:00","exception":false,"start_time":"2026-10-18T14:29:31.771335+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["\n","=== X6  DL minus XGBoost-paper in explanation quality (KernelSHAP for both, paired over the same children; 95% CI) ===\n","dataset   model     metric   diff  ci_low  ci_high  p_boot       verdict  p_holm\n"," Poland     MLP   del_gain -0.019  -0.028   -0