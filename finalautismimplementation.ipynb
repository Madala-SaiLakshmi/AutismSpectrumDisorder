        0.065\n"]}],"source":["if RUN_A:\n","    sat = []\n","    for (ds, fs, m), recs in CKPT[\"preds\"].items():\n","        if m in ML_MODELS and fs == \"13f\":\n","            p = np.concatenate([np.asarray(r[\"p\"], float) for r in recs])\n","            sat.append(dict(dataset=ds, model=m, share_exact_0_or_1=float(np.mean((p <= 1e-7) | (p >= 1 - 1e-7))),\n","                            share_tied_values=float(1 - len(np.unique(p)) / len(p))))\n","    SAT = pd.DataFrame(sat)\n","    if len(SAT):\n","        print(\"=== saturation check of the stored test probabilities (13 features) ===\")\n","        print(SAT.groupby([\"dataset\", \"model\"]).mean().round(3).to_string())"]},{"cell_type":"markdown","id":"1874096f","metadata":{"papermill":{"duration":0.016943,"end_time":"2026-10-18T11:05:28.684789+00:00","exception":false,"start_time":"2026-10-18T11:05:28.667846+00:00","status":"completed"},"tags":[]},"source":["### Save the ML-style tables"]},{"cell_type":"code","execution_count":45,"id":"a4e20e29","metadata":{"execution":{"iopub.execute_input":"2026-10-18T11:05:28.720459Z","iopub.status.busy":"2026-10-18T11:05:28.720098Z","iopub.status.idle":"2026-10-18T11:05:28.728734Z","shell.execute_reply":"2026-10-18T11:05:28.728048Z"},"papermill":{"duration":0.02862,"end_time":"2026-10-18T11:05:28.730299+00:00","exception":false,"start_time":"2026-10-18T11:05:28.701679+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["saved ml_style_same_dataset.csv\n"]}],"source":["if RUN_A:\n","    if ML_ALL:\n","        pd.concat(ML_ALL).to_csv(os.path.join(CFG[\"OUT_DIR\"], \"ml_style_same_dataset.csv\"), index=False)\n","        print(\"saved ml_style_same_dataset.csv\")"]},{"cell_type":"markdown","id":"3bb1f342","metadata":{"papermill":{"duration":0.017078,"end_time":"2026-10-18T11:05:28.764113+00:00","exception":false,"start_time":"2026-10-18T11:05:28.747035+00:00","status":"completed"},"tags":[]},"source":["# Maximize Recall: cross-dataset generalisation (Part B)\n","Train on one whole country, test on another (6 ordered pairs). The source country is split into inner-train / inner-validation for early stopping and tuning; the target country is used only for the final evaluation. Feature sets: all 13 features, and a 4-item set found on the source country.\n","## Settings and checkpoint"]},{"cell_type":"code","execution_count":46,"id":"dfd72b3e","metadata":{"execution":{"iopub.execute_input":"2026-10-18T11:05:28.800846Z","iopub.status.busy":"2026-10-18T11:05:28.800513Z","iopub.status.idle":"2026-10-18T11:05:28.80701Z","shell.execute_reply":"2026-10-18T11:05:28.806255Z"},"papermill":{"duration":0.027375,"end_time":"2026-10-18T11:05:28.808505+00:00","exception":false,"start_time":"2026-10-18T11:05:28.78113+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["CROSS_REPS = {\"quick\": 1, \"standard\": 2, \"full\": 3}[CFG[\"PRESET\"]]    # independent refits (different inner split + seeds)\n","CROSS_B = {\"quick\": 300, \"standard\": 400, \"full\": 500}[CFG[\"PRESET\"]]  # bootstrap resamples of the target children\n","CROSS_DL = list(DL_MODELS)                                              # Stage A models only\n","CROSS_FIT = [\"XGBoost-paper\"] + CROSS_DL\n","FSETS = [\"13f\", \"4f-src\"]\n","FOUR_SRC = {\"NZ\": [\"A5_Score\", \"A6_Score\", \"A7_Score\", \"A9_Score\"], \"Saudi\": [\"A2_Score\", \"A6_Score\", \"A8_Score\", \"A9_Score\"],\n","            \"Poland\": list(FOUR_FEATURES)}   # the 4-item set found on the source country in the earlier work\n","CROSS_PATH = os.path.join(CFG[\"OUT_DIR\"], \"cross_ckpt_v2.pkl\")   # v2 = stores pre-sigmoid scores for the AUC\n","if os.path.exists(CROSS_PATH):\n","    CROSS = pickle.load(open(CROSS_PATH, \"rb\"))\n","    print(\"resumed cross-dataset checkpoint:\", len(CROSS[\"pred\"]), \"fits\")\n","else:\n","    CROSS = dict(pred={}, params={})"]},{"cell_type":"markdown","id":"a0a7682c","metadata":{"papermill":{"duration":0.017371,"end_time":"2026-10-18T11:05:28.842629+00:00","exception":false,"start_time":"2026-10-18T11:05:28.825258+00:00","status":"completed"},"tags":[]},"source":["## Cross-dataset runner"]},{"cell_type":"code","execution_count":47,"id":"cf910d2c","metadata":{"execution":{"iopub.execute_input":"2026-10-18T11:05:28.879387Z","iopub.status.busy":"2026-10-18T11:05:28.878741Z","iopub.status.idle":"2026-10-18T11:05:28.891918Z","shell.execute_reply":"2026-10-18T11:05:28.891218Z"},"papermill":{"duration":0.034028,"end_time":"2026-10-18T11:05:28.893418+00:00","exception":false,"start_time":"2026-10-18T11:05:28.85939+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["def _to_logit(p):\n","    p = np.clip(np.asarray(p, dtype=\"float64\"), 1e-12, 1 - 1e-12)\n","    return np.log(p / (1 - p))\n","\n","\n","def _score(m, X):\n","    \"\"\"Pre-sigmoid score used for AUC. float32 sigmoids saturate at exactly 0/1 for confident networks, which creates false ties\n","    and would understate the AUC; the logit keeps the ranking.\"\"\"\n","    return m.predict_score(X) if hasattr(m, \"predict_score\") else _to_logit(m.predict_proba(X))\n","\n","\n","def _save_cross():\n","    pickle.dump(CROSS, open(CROSS_PATH + \".tmp\", \"wb\"))\n","    os.replace(CROSS_PATH + \".tmp\", CROSS_PATH)\n","\n","\n","def run_cross():\n","    t_all = time.time()\n","    for src in DS:\n","        Xs, ys = DS[src]\n","        imp = SimpleImputer(strategy=\"most_frequent\").fit(Xs)           # fitted on the source country only\n","        Xs_i = pd.DataFrame(imp.transform(Xs), columns=BASE_FEATURES)\n","        tgts = [t for t in DS if t != src]\n","        Xt_all = {t: pd.DataFrame(imp.transform(DS[t][0]), columns=BASE_FEATURES) for t in tgts}\n","        for fset in FSETS:\n","            feats = list(BASE_FEATURES if fset == \"13f\" else FOUR_SRC[src])\n","            globals()[\"CURRENT_FEATS\"] = feats\n","            Xt = {t: Xt_all[t][feats].values.astype(\"float32\") for t in tgts}\n","            for model in CROSS_FIT + [\"XGBoost-paper-full\"]:   # \"-full\" = base-paper style: trained on 100% of the source, for reference\n","                t0, done_now = time.time(), False\n","                for rep in range(CROSS_REPS):\n","                    key = (src, fset, model, rep)\n","                    if key in CROSS[\"pred\"]:\n","                        continue\n","                    seed = CFG[\"SEED\"] + 777 * rep\n","                    a, b = inner_split(ys, seed)\n","                    Xfit, yfit = Xs_i.iloc[a][feats].values.astype(\"float32\"), ys[a]\n","                    Xva, yva = Xs_i.iloc[b][feats].values.astype(\"float32\"), ys[b]\n","                    try:\n","                        if model == \"XGBoost-paper-full\":\n","                            m = make_model(\"XGBoost-paper\", {}, seed, src).fit(Xs_i[feats].values.astype(\"float32\"), ys, Xva, yva)\n","                        else:\n","                            params = {}\n","                            if model in CROSS_DL and model != \"TabPFN\":\n","                                pkey = (src, fset, model)\n","                                if pkey not in CROSS[\"params\"]:   # tuned once per source/feature set on the rep-0 validation split\n","                                    CROSS[\"params\"][pkey] = tune_params(model, src, Xfit, yfit, Xva, yva, seed)\n","                                params = CROSS[\"params\"][pkey]\n","                            m = make_model(model, params, seed, src, CFG[\"ENS_SEEDS\"]).fit(Xfit, yfit, Xva, yva)\n","                        CROSS[\"pred\"][key] = dict(y_va=yva, p_va=m.predict_proba(Xva), s_va=_score(m, Xva),\n","                                                  **{\"to_\" + t: m.predict_proba(Xt[t]) for t in tgts},\n","                                                  **{\"sc_\" + t: _score(m, Xt[t]) for t in tgts})\n","                        done_now = True\n","                    except Exception as e:\n","                        print(f\"  !! SKIPPED {src}/{fset}/{model}: {type(e).__name__}: {str(e)[:160]}\")\n","                        break\n","                if done_now:\n","                    _save_cross()\n","                    print(f\"  train {src:7s} {fset:6s} {model:20s} done ({time.time() - t0:.0f}s)\")\n","    print(f\"cross-dataset fitting finished in {(time.time() - t_all) / 60:.1f} min\")"]},{"cell_type":"markdown","id":"cef5baad","metadata":{"papermill":{"duration":0.01676,"end_time":"2026-10-18T11:05:28.927147+00:00","exception":false,"start_time":"2026-10-18T11:05:28.910387+00:00","status":"completed"},"tags":[]},"source":["### Run: train on each whole country, test on the other two\n","`cross_ckpt_v2.pkl` stores pre-sigmoid scores (AUC is computed from them to avoid float32 ties) and makes the run resumable."]},{"cell_type":"code","execution_count":48,"id":"b65bb767","metadata":{"execution":{"iopub.execute_input":"2026-10-18T11:05:28.963221Z","iopub.status.busy":"2026-10-18T11:05:28.962862Z","iopub.status.idle":"2026-10-18T11:44:32.591159Z","shell.execute_reply":"2026-10-18T11:44:32.590135Z"},"papermill":{"duration":2343.648715,"end_time":"2026-10-18T11:44:32.592874+00:00","exception":false,"start_time":"2026-10-18T11:05:28.944159+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["  train Poland  13f    XGBoost-paper        done (0s)\n","  train Poland  13f    MLP                  done (16s)\n","  train Poland  13f    MLP-PLE              done (18s)\n","  train Poland  13f    MLP-PLR              done (23s)\n","  train Poland  13f    FT-Transformer       done (36s)\n","  train Poland  13f    TabPFN               done (8s)\n","  train Poland  13f    XGBoost-paper-full   done (0s)\n","  train Poland  4f-src XGBoost-paper        done (0s)\n","  train Poland  4f-src MLP                  done (8s)\n","  train Poland  4f-src MLP-PLE              done (17s)\n","  train Poland  4f-src MLP-PLR              done (22s)\n","  train Poland  4f-src FT-Transformer       done (64s)\n","  train Poland  4f-src TabPFN               done (7s)\n","  train Poland  4f-src XGBoost-paper-full   done (0s)\n","  train NZ      13f    XGBoost-paper        done (0s)\n","  train NZ      13f    MLP                  done (89s)\n","  train NZ      13f    MLP-PLE              done (148s)\n","  train NZ      13f    MLP-PLR              done (101s)\n","  train NZ      13f    FT-Transformer       done (663s)\n","  train NZ      13f    TabPFN               done (9s)\n","  train NZ      13f    XGBoost-paper-full   done (0s)\n","  train NZ      4f-src XGBoost-paper        done (0s)\n","  train NZ      4f-src MLP                  done (28s)\n","  train NZ      4f-src MLP-PLE              done (35s)\n","  train NZ      4f-src MLP-PLR              done (45s)\n","  train NZ      4f-src FT-Transformer       done (122s)\n","  train NZ      4f-src TabPFN               done (16s)\n","  train NZ      4f-src XGBoost-paper-full   done (0s)\n","  train Saudi   13f    XGBoost-paper        done (0s)\n","  train Saudi   13f    MLP                  done (46s)\n","  train Saudi   13f    MLP-PLE              done (64s)\n","  train Saudi   13f    MLP-PLR              done (61s)\n","  train Saudi   13f    FT-Transformer       done (396s)\n","  train Saudi   13f    TabPFN               done (8s)\n","  train Saudi   13f    XGBoost-paper-full   done (0s)\n","  train Saudi   4f-src XGBoost-paper        done (0s)\n","  train Saudi   4f-src MLP                  done (20s)\n","  train Saudi   4f-src MLP-PLE              done (27s)\n","  train Saudi   4f-src MLP-PLR              done (29s)\n","  train Saudi   4f-src FT-Transformer       done (205s)\n","  train Saudi   4f-src TabPFN               done (9s)\n","  train Saudi   4f-src XGBoost-paper-full   done (0s)\n","cross-dataset fitting finished in 39.1 min\n"]}],"source":["if RUN_B:\n","    run_cross()"]},{"cell_type":"markdown","id":"b21d5160","metadata":{"papermill":{"duration":0.018732,"end_time":"2026-10-18T11:44:32.631754+00:00","exception":false,"start_time":"2026-10-18T11:44:32.613022+00:00","status":"completed"},"tags":[]},"source":["## Evaluation: predictions, metrics and paired bootstrap\n","Differences to XGBoost are bootstrapped over the target children (paired); equivalence uses the 90% interval; Holm correction is applied within each group; intervals are widened to contain the observed difference."]},{"cell_type":"code","execution_count":49,"id":"bdfe6c23","metadata":{"execution":{"iopub.execute_input":"2026-10-18T11:44:32.669837Z","iopub.status.busy":"2026-10-18T11:44:32.669268Z","iopub.status.idle":"2026-10-18T11:44:32.680898Z","shell.execute_reply":"2026-10-18T11:44:32.68025Z"},"papermill":{"duration":0.031963,"end_time":"2026-10-18T11:44:32.682322+00:00","exception":false,"start_time":"2026-10-18T11:44:32.650359+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["ENS_ALL, ENS_TOP3 = \"DL Ensemble (all)\", \"DL Ensemble (top3 by val AUC)\"\n","\n","\n","def get_preds(src, tgt, fset):\n","    \"\"\"(P, S): model -> array (reps, n_target) of probabilities (thresholds, Brier, ECE) and of pre-sigmoid scores (AUC).\"\"\"\n","    P, S = {}, {}\n","    for model in CROSS_FIT + [\"XGBoost-paper-full\"]:\n","        ps = [CROSS[\"pred\"].get((src, fset, model, r)) for r in range(CROSS_REPS)]\n","        if any(p is None for p in ps):\n","            continue\n","        P[model] = np.stack([p[\"to_\" + tgt] for p in ps])\n","        S[model] = np.stack([p[\"sc_\" + tgt] for p in ps])\n","    have = [m for m in CROSS_DL if m in P]\n","    if len(have) >= 2:\n","        P[ENS_ALL], S[ENS_ALL] = np.mean([P[m] for m in have], 0), np.mean([S[m] for m in have], 0)\n","        top_p, top_s = [], []\n","        for r in range(CROSS_REPS):   # top-3 chosen by validation AUC on the SOURCE country only\n","            aucs = [roc_auc_score(CROSS[\"pred\"][(src, fset, m, r)][\"y_va\"], CROSS[\"pred\"][(src, fset, m, r)][\"s_va\"]) for m in have]\n","            sel = [have[i] for i in np.argsort(aucs)[::-1][:3]]\n","            top_p.append(np.mean([P[m][r] for m in sel], 0))\n","            top_s.append(np.mean([S[m][r] for m in sel], 0))\n","        P[ENS_TOP3], S[ENS_TOP3] = np.stack(top_p), np.stack(top_s)\n","    return P, S\n","\n","\n","def cross_metrics(y, p, s):\n","    \"\"\"Threshold metrics, Brier and ECE from the probabilities; AUC / PR-AUC / sensitivity@90%specificity from the scores.\"\"\"\n","    m = all_metrics(y, p)\n","    m[\"AUC\"], m[\"PRAUC\"], m[\"Sens_at_90Spec\"] = roc_auc_score(y, s), average_precision_score(y, s), sens_at_spec(y, s)\n","    return m\n","\n","\n","def boot_metric(y, P, S, idx, kind):\n","    \"\"\"For each bootstrap resample of the target children: the metric averaged over the repetitions.\"\"\"\n","    out = np.zeros(len(idx))\n","    for bi, ii in enumerate(idx):\n","        yb, vals = y[ii], []\n","        for p, sc_ in zip(P, S):\n","            if kind == \"AUC\":\n","                vals.append(roc_auc_score(yb, sc_[ii]))\n","            else:\n","                pr = p[ii] >= 0.5\n","                se = (pr & (yb == 1)).sum() / max((yb == 1).sum(), 1)\n","                sp = ((~pr) & (yb == 0)).sum() / max((yb == 0).sum(), 1)\n","                vals.append((se + sp) / 2)\n","        out[bi] = np.mean(vals)\n","    return out"]},{"cell_type":"markdown","id":"c06a7541","metadata":{"papermill":{"duration":0.017248,"end_time":"2026-10-18T11:44:32.716827+00:00","exception":false,"start_time":"2026-10-18T11:44:32.699579+00:00","status":"completed"},"tags":[]},"source":["## Bootstrap evaluation of every train → test pair"]},{"cell_type":"code","execution_count":50,"id":"228a891a","metadata":{"execution":{"iopub.execute_input":"2026-10-18T11:44:32.753567Z","iopub.status.busy":"2026-10-18T11:44:32.753332Z","iopub.status.idle":"2026-10-18T11:47:55.553388Z","shell.execute_reply":"2026-10-18T11:47:55.552663Z"},"papermill":{"duration":202.82131,"end_time":"2026-10-18T11:47:55.555574+00:00","exception":false,"start_time":"2026-10-18T11:44:32.734264+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["if RUN_B:\n","    MODEL_ORDER = [\"XGBoost-paper-full\", \"XGBoost-paper\"] + CROSS_DL + [ENS_ALL, ENS_TOP3]\n","    SHOWC = [\"BalAcc\", \"AUC\", \"Sens\", \"Spec\", \"BalAcc_t03\", \"Brier\", \"ECE\"]\n","    perf_rows, cmp_rows = [], []\n","    for src in DS:\n","        for tgt in DS:\n","            if tgt == src:\n","                continue\n","            y = DS[tgt][1]\n","            rng = np.random.RandomState(CFG[\"SEED\"])\n","            idx = rng.randint(0, len(y), (CROSS_B, len(y)))   # the same resamples for every model -> paired differences\n","            for fset in FSETS:\n","                preds, scs = get_preds(src, tgt, fset)\n","                if \"XGBoost-paper\" not in preds:\n","                    continue\n","                for m in MODEL_ORDER:\n","                    if m in preds:\n","                        r = pd.DataFrame([cross_metrics(y, p, s_) for p, s_ in zip(preds[m], scs[m])])\n","                        perf_rows.append(dict(src=src, tgt=tgt, fset=fset, model=m, **{k: r[k].mean() for k in SHOWC}, **{k + \"_sd\": r[k].std() for k in SHOWC}))\n","                for metric in (\"AUC\", \"BalAcc\"):\n","                    ref_b = boot_metric(y, preds[\"XGBoost-paper\"], scs[\"XGBoost-paper\"], idx, metric)\n","                    ref_pt = np.mean([cross_metrics(y, p, s_)[metric] for p, s_ in zip(preds[\"XGBoost-paper\"], scs[\"XGBoost-paper\"])])\n","                    grp = []\n","                    for m in CROSS_DL + [ENS_ALL, ENS_TOP3]:\n","                        if m not in preds:\n","                            continue\n","                        d = boot_metric(y, preds[m], scs[m], idx, metric) - ref_b\n","                        pt = np.mean([cross_metrics(y, p, s_)[metric] for p, s_ in zip(preds[m], scs[m])])\n","                        lo95, hi95 = np.percentile(d, [2.5, 97.5])\n","                        lo90, hi90 = np.percentile(d, [5, 95])\n","                        # a percentile bootstrap can land slightly off the observed difference; keep every interval around it\n","                        lo95, hi95 = min(lo95, pt - ref_pt), max(hi95, pt - ref_pt)\n","                        lo90, hi90 = min(lo90, pt - ref_pt), max(hi90, pt - ref_pt)\n","                        delta = CFG[\"DELTA\"][metric]\n","                        grp.append(dict(src=src, tgt=tgt, fset=fset, metric=metric, model=m, mean_model=pt, mean_xgb=ref_pt, diff=pt - ref_pt,\n","                                        ci95_low=lo95, ci95_high=hi95, p_boot=max(2 * min((d <= 0).mean(), (d >= 0).mean()), 1.0 / len(d)),\n","                                        equivalent=bool(lo90 > -delta and hi90 < delta), delta=delta))\n","                    if grp:\n","                        g = pd.DataFrame(grp)\n","                        g[\"p_holm\"] = holm(g[\"p_boot\"].values)\n","                        g[\"verdict\"] = [f\"EQUIVALENT (within ±{r_.delta:.2f})\" if r_.equivalent else\n","                                        ((\"SIGNIFICANTLY BETTER\" if r_[\"diff\"] > 0 else \"SIGNIFICANTLY WORSE\") if r_.p_holm < 0.05 else\n","                                         (\"inconclusive (higher mean)\" if r_[\"diff\"] > 0 else \"inconclusive (lower mean)\")) for _, r_ in g.iterrows()]\n","                        cmp_rows.append(g)"]},{"cell_type":"markdown","id":"3aaf1d6d","metadata":{"papermill":{"duration":0.017939,"end_time":"2026-10-18T11:47:55.593396+00:00","exception":false,"start_time":"2026-10-18T11:47:55.575457+00:00","status":"completed"},"tags":[]},"source":["### Performance tables and DL vs XGBoost comparison"]},{"cell_type":"code","execution_count":51,"id":"548f202d","metadata":{"execution":{"iopub.execute_input":"2026-10-18T11:47:55.631876Z","iopub.status.busy":"2026-10-18T11:47:55.631169Z","iopub.status.idle":"2026-10-18T11:47:55.822439Z","shell.execute_r