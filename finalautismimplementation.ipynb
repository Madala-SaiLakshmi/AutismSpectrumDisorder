di   top4    AUC     | equivalent: ['DL Ensemble (all)', 'DL Ensemble (top3 by val AUC)', 'FT-Transformer', 'MLP', 'MLP-PLE', 'MLP-PLR', 'TabPFN'] | significantly better: - | mean >= +1pt (inconclusive): -\n","Saudi   top4    BalAcc  | equivalent: ['MLP', 'TabPFN'] | significantly better: - | mean >= +1pt (inconclusive): -\n","Saudi   top4    BalAcc_valthr | equivalent: ['DL Ensemble (all)', 'DL Ensemble (top3 by val AUC)', 'FT-Transformer', 'MLP', 'MLP-PLE', 'MLP-PLR', 'TabPFN'] | significantly better: - | mean >= +1pt (inconclusive): -\n"]}],"source":["if RUN_A:\n","    CMP = full_comparison(RES)\n","    CMP.round(4).to_csv(os.path.join(CFG[\"OUT_DIR\"], \"table2_dl_vs_baselines.csv\"), index=False)\n","    if len(CMP):\n","        main = CMP[(CMP.model.isin(DL_ALL)) & (CMP.metric.isin([\"BalAcc\", \"BalAcc_valthr\", \"AUC\"]))]\n","        cols = [\"dataset\", \"fset\", \"metric\", \"model\", \"mean_model\", \"mean_ref\", \"diff\", \"ci95_low\", \"ci95_high\", \"p_holm\", \"verdict\"]\n","        for ref in CFG[\"REFS\"]:\n","            print(f\"\\n########  DL techniques vs {ref}  (balanced accuracy and AUC)  ########\")\n","            print(main[main.ref == ref][cols].round(4).to_string(index=False))\n","\n","        print(\"\\n########  SUMMARY: DL techniques statistically equivalent to / better than XGBoost-paper  ########\")\n","        xs = CMP[(CMP.ref == \"XGBoost-paper\") & (CMP.model.isin(DL_ALL)) & (CMP.metric.isin([\"BalAcc\", \"BalAcc_valthr\", \"AUC\"]))]\n","        for (ds, fs, met), sub in xs.groupby([\"dataset\", \"fset\", \"metric\"]):\n","            eq = sub[sub.verdict.str.startswith(\"EQUIVALENT\")].model.tolist()\n","            bt = sub[sub.verdict == \"SIGNIFICANTLY BETTER\"].model.tolist()\n","            hi = sub[(sub[\"diff\"] >= 0.01) & ~sub.verdict.str.startswith((\"EQUIV\", \"SIGNIFICANTLY\"))].model.tolist()\n","            print(f\"{ds:7s} {fs:7s} {met:7s} | equivalent: {eq or '-'} | significantly better: {bt or '-'} | mean >= +1pt (inconclusive): {hi or '-'}\")"]},{"cell_type":"markdown","id":"2eca8d6e","metadata":{"papermill":{"duration":0.01502,"end_time":"2026-10-18T11:05:21.460856+00:00","exception":false,"start_time":"2026-10-18T11:05:21.445836+00:00","status":"completed"},"tags":[]},"source":["### Forest plot: DL minus XGBoost with 95% CI"]},{"cell_type":"code","execution_count":33,"id":"a269e839","metadata":{"execution":{"iopub.execute_input":"2026-10-18T11:05:21.491876Z","iopub.status.busy":"2026-10-18T11:05:21.491103Z","iopub.status.idle":"2026-10-18T11:05:21.499989Z","shell.execute_reply":"2026-10-18T11:05:21.499426Z"},"papermill":{"duration":0.025851,"end_time":"2026-10-18T11:05:21.501489+00:00","exception":false,"start_time":"2026-10-18T11:05:21.475638+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["def forest_plot(cmp_df, ref=\"XGBoost-paper\", metrics=(\"BalAcc\", \"BalAcc_valthr\", \"AUC\")):\n","    panels = [(ds, fs) for ds in DS for fs in FEATURE_SETS[ds]]\n","    fig, axes = plt.subplots(len(panels), len(metrics), figsize=(5.2 * len(metrics), 2.3 * len(panels) + 1), squeeze=False)\n","    for i, (ds, fs) in enumerate(panels):\n","        for j, met in enumerate(metrics):\n","            ax = axes[i][j]\n","            sub = cmp_df[(cmp_df.dataset == ds) & (cmp_df.fset == fs) & (cmp_df.metric == met) & (cmp_df.ref == ref)]\n","            sub = sub[sub.model.isin(DL_ALL)]\n","            if sub.empty:\n","                ax.axis(\"off\")\n","                continue\n","            sub = sub.set_index(\"model\").reindex([m for m in BASELINES + DL_MODELS + ENSEMBLES if m in set(sub.model)])\n","            y = np.arange(len(sub))[::-1]\n","            delta = CFG[\"DELTA\"][met]\n","            ax.axvspan(-delta, delta, color=\"#cfe3f5\", alpha=0.6, label=f\"±{delta:.2f} equivalence\")\n","            ax.axvline(0, color=\"k\", lw=1)\n","            ax.errorbar(sub[\"diff\"], y, xerr=[sub[\"diff\"] - sub[\"ci95_low\"], sub[\"ci95_high\"] - sub[\"diff\"]], fmt=\"o\", color=\"#1b4f8a\", capsize=3)\n","            ax.set_yticks(y)\n","            ax.set_yticklabels(sub.index, fontsize=8)\n","            ax.set_title(f\"{ds} | {fs} | {met}\", fontsize=9)\n","            ax.set_xlabel(f\"model minus {ref} (95% CI)\", fontsize=8)\n","    axes[0][0].legend(fontsize=7, loc=\"lower right\")\n","    plt.tight_layout()\n","    plt.savefig(os.path.join(CFG[\"OUT_DIR\"], \"fig_forest_vs_xgboost.png\"), dpi=200)\n","    plt.show()"]},{"cell_type":"markdown","id":"f4de6ab7","metadata":{"papermill":{"duration":0.014082,"end_time":"2026-10-18T11:05:21.529525+00:00","exception":false,"start_time":"2026-10-18T11:05:21.515443+00:00","status":"completed"},"tags":[]},"source":["### Draw the forest plot"]},{"cell_type":"code","execution_count":34,"id":"da72d38f","metadata":{"execution":{"iopub.execute_input":"2026-10-18T11:05:21.563885Z","iopub.status.busy":"2026-10-18T11:05:21.563505Z","iopub.status.idle":"2026-10-18T11:05:25.926183Z","shell.execute_reply":"2026-10-18T11:05:25.92532Z"},"papermill":{"duration":4.38487,"end_time":"2026-10-18T11:05:25.930205+00:00","exception":false,"start_time":"2026-10-18T11:05:21.545335+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"image/png":"\n","text/plain":["<Figure size 1560x1710 with 21 Axes>"]},"metadata":{},"output_type":"display_data"}],"source":["if RUN_A:\n","    if len(CMP):\n","        forest_plot(CMP)"]},{"cell_type":"markdown","id":"52aa9b47","metadata":{"papermill":{"duration":0.016679,"end_time":"2026-10-18T11:05:25.965333+00:00","exception":false,"start_time":"2026-10-18T11:05:25.948654+00:00","status":"completed"},"tags":[]},"source":["## ML-style report (same pattern as the base paper's ML notebook)\n","Per dataset and feature set: ROC-AUC / balanced accuracy / sensitivity / specificity as mean ± std over the 5 folds of repeat 0, at threshold 0.5 and 0.3, with pooled confusion matrices."]},{"cell_type":"code","execution_count":35,"id":"811db1e6","metadata":{"execution":{"iopub.execute_input":"2026-10-18T11:05:26.000147Z","iopub.status.busy":"2026-10-18T11:05:25.999318Z","iopub.status.idle":"2026-10-18T11:05:26.011384Z","shell.execute_reply":"2026-10-18T11:05:26.010527Z"},"papermill":{"duration":0.030886,"end_time":"2026-10-18T11:05:26.012919+00:00","exception":false,"start_time":"2026-10-18T11:05:25.982033+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["from sklearn.metrics import ConfusionMatrixDisplay\n","\n","ML_MODELS = BASELINES + DL_MODELS + [\"DL Ensemble (all)\", \"DL Ensemble (top3 by val AUC)\"]\n","FS_NAME = {\"13f\": \"all 13 features\", \"top4\": \"top-4 features (chosen inside each fold)\", \"paper4\": \"4 features of the base paper (A2-A5)\"}\n","HEAD3 = [\"XGBoost-paper\", \"MLP\", \"TabPFN\", \"DL Ensemble (all)\"]   # models whose confusion matrices are printed\n","ML_ALL = []\n","\n","\n","def ml_style(ds, fs, thr, models=ML_MODELS):\n","    rows, cms = [], {}\n","    for m in models:\n","        recs = [r for r in CKPT[\"preds\"].get((ds, fs, m), []) if r[\"rep\"] == 0]\n","        if not recs:\n","            continue\n","        per = {\"ROC-AUC\": [], \"Balanced accuracy\": [], \"Sensitivity\": [], \"Specificity\": []}\n","        cm = np.zeros((2, 2), int)\n","        for r in recs:\n","            y, p = np.asarray(r[\"y\"]).astype(int), np.asarray(r[\"p\"], float)\n","            tn, fp, fn, tp = confusion_matrix(y, (p >= thr).astype(int), labels=[0, 1]).ravel()\n","            se, sp = tp / max(tp + fn, 1), tn / max(tn + fp, 1)\n","            per[\"ROC-AUC\"].append(roc_auc_score(y, p)); per[\"Balanced accuracy\"].append((se + sp) / 2)\n","            per[\"Sensitivity\"].append(se); per[\"Specificity\"].append(sp)\n","            cm += np.array([[tn, fp], [fn, tp]])\n","        cms[m] = cm\n","        rows.append(dict(model=m, **{k: f\"{np.mean(v):.2f} ± {np.std(v):.2f}\" for k, v in per.items()},\n","                         **{k + \"_mean\": np.mean(v) for k, v in per.items()}))\n","    return pd.DataFrame(rows), cms\n","\n","\n","def show_ml_style(ds, fs):\n","    for thr in (0.5, 0.3):\n","        tab, cms = ml_style(ds, fs, thr)\n","        if not len(tab):\n","            print(f\"(no results for {ds} / {fs})\")\n","            return\n","        print(f\"\\n=== {ds} | {FS_NAME[fs]} | 5-fold CV (repeat 0) | threshold {thr} ===\")\n","        print(tab[[\"model\", \"ROC-AUC\", \"Balanced accuracy\", \"Sensitivity\", \"Specificity\"]].to_string(index=False))\n","        for m in HEAD3:\n","            if m in cms:\n","                print(f\"Confusion matrix, {m} (all test folds pooled):  [[TN FP], [FN TP]] = {cms[m].tolist()}\")\n","        ML_ALL.append(tab.assign(dataset=ds, fset=fs, threshold=thr))"]},{"cell_type":"markdown","id":"92d232b2","metadata":{"papermill":{"duration":0.016389,"end_time":"2026-10-18T11:05:26.045322+00:00","exception":false,"start_time":"2026-10-18T11:05:26.028933+00:00","status":"completed"},"tags":[]},"source":["### Polish dataset\n","#### All 13 features"]},{"cell_type":"code","execution_count":36,"id":"1437f634","metadata":{"execution":{"iopub.execute_input":"2026-10-18T11:05:26.07893Z","iopub.status.busy":"2026-10-18T11:05:26.0785Z","iopub.status.idle":"2026-10-18T11:05:26.279825Z","shell.execute_reply":"2026-10-18T11:05:26.278814Z"},"papermill":{"duration":0.219417,"end_time":"2026-10-18T11:05:26.28156+00:00","exception":false,"start_time":"2026-10-18T11:05:26.062143+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["\n","=== Poland | all 13 features | 5-fold CV (repeat 0) | threshold 0.5 ===\n","                        model     ROC-AUC Balanced accuracy Sensitivity Specificity\n","                XGBoost-paper 0.94 ± 0.05       0.86 ± 0.06 0.83 ± 0.08 0.89 ± 0.04\n","                          MLP 0.95 ± 0.04       0.86 ± 0.04 0.84 ± 0.08 0.88 ± 0.06\n","                      MLP-PLE 0.93 ± 0.06       0.85 ± 0.05 0.85 ± 0.07 0.85 ± 0.04\n","                   